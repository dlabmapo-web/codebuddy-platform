# Cove Studio v2 web application. Copy to .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_publishable_key
NEXT_PUBLIC_API_URL=http://localhost:4000/api/rpc
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must match the API value. Server-only; never expose this as NEXT_PUBLIC_*.
BFF_SHARED_SECRET=replace_with_at_least_32_random_bytes
