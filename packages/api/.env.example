# Cove Studio v2 API only. Copy this file to .env and replace every placeholder.
NODE_ENV=development
PORT=4000
# Production value. Use http://localhost:3000 in local development.
WEB_ORIGIN=https://cs.coveedu.com

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=replace_with_supabase_secret_key

# Must match the web application's value. Required in production; use 32+ random bytes.
BFF_SHARED_SECRET=replace_with_at_least_32_random_bytes

# Runtime connection. Use the Supavisor session pooler (port 5432) for local NestJS.
DATABASE_URL=postgresql://replace_with_runtime_connection

# Prisma CLI connection. Prefer the direct connection (port 5432) when IPv6 is available.
DIRECT_URL=postgresql://replace_with_migration_connection

# BullMQ grading queue. Keep Redis private; never expose port 6379 publicly.
REDIS_URL=redis://localhost:6379

# Optional separate Redis for live-monitoring streams. Falls back to REDIS_URL.
MONITORING_REDIS_URL=redis://localhost:6379
MONITORING_STREAM_MAX_LENGTH=10000

# CPU-bound judge workers. Tune to the CPU actually reserved for this process.
JUDGE_CONCURRENCY=4
PYODIDE_VERSION=0.27.5
SUBMISSION_RATE_LIMIT=10

# Resend invitation delivery. All three are required when NODE_ENV=production.
# Create a sending-only key restricted to mail.coveedu.com. Never use NEXT_PUBLIC_*.
EMAIL_API_KEY=re_replace_with_cove_api_sending_key
EMAIL_FROM="Cove Studio <no-reply@mail.coveedu.com>"
EMAIL_WEBHOOK_SECRET=whsec_replace_with_webhook_signing_secret

PLATFORM_ORGANIZATION_SLUG=cove

# One-time admin bootstrap only. Leave both unset except during the controlled
# bootstrap command, then remove them from the runtime environment.
# PLATFORM_BOOTSTRAP_ADMIN_EMAIL=operator@example.com
# PLATFORM_BOOTSTRAP_ENV=production
