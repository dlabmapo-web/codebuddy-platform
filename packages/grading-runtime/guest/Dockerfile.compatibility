FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS node
FROM python:3.12.16-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337 AS compiler
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev && rm -rf /var/lib/apt/lists/*
COPY packages/grading-runtime/guest/gated-launcher.c /build/gated-launcher.c
RUN gcc -O2 -Wall -Wextra -Werror /build/gated-launcher.c -o /build/gated-launcher
FROM python:3.12.16-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337
ARG PACKAGE_MANIFEST_HASH
LABEL io.cove.grading.package=$PACKAGE_MANIFEST_HASH io.cove.grading.shim="cove-guest-1" io.cove.grading.engine="pyodide" io.cove.grading.version="0.27.5" io.cove.grading.python="3.12.7"
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=compiler /build/gated-launcher /opt/guest/gated-launcher
COPY packages/grading-runtime/guest/supervisor.py /opt/guest/supervisor.py
COPY packages/grading-runtime/guest/artifacts/pyodide-runner.mjs /opt/guest/pyodide-runner.mjs
COPY packages/grading-runtime/guest/artifacts/pyodide /opt/pyodide
COPY packages/grading-runtime/guest/artifacts/pyodide-identity.json /opt/guest/identity.json
COPY packages/grading-runtime/guest/artifacts/pyodide-manifest.json /opt/guest/package-manifest.json
RUN node --version && node --input-type=module -e 'import {loadPyodide} from "/opt/pyodide/pyodide.mjs"; const p=await loadPyodide({indexURL:"/opt/pyodide/"}); if(p.runPython("import platform; platform.python_version()")!=="3.12.7") process.exit(1)' && test -n "$PACKAGE_MANIFEST_HASH" && python3 -c 'import json,os; assert json.load(open("/opt/guest/identity.json"))["packageManifestHash"] == os.environ["PACKAGE_MANIFEST_HASH"]'
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ENTRYPOINT ["python3", "-I", "-u", "/opt/guest/supervisor.py"]
