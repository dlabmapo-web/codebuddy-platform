# One trusted broker per Docker daemon. Start with one learner slot on this VPS.
GUI_SERVICE_SECRET=replace_with_same_random_secret_as_api
GUI_ALLOWED_ORIGINS=https://cs.coveedu.com
GUI_RUNTIME_IMAGE=ghcr.io/dlabmapo-web/cove-gui-runtime@sha256:replace_with_approved_digest
# Managed by pin-gui-runtime.sh. Exact previous approved runtimes remain
# available for existing lessons and immutable submitted work.
GUI_RETAINED_RUNTIME_IMAGES=
GUI_SESSION_CAPACITY=1
