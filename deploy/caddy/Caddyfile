{
	email {$ACME_EMAIL}
	# Port 2019 is reachable only on Docker's private networks and is scraped by
	# Prometheus. It is never published on the VPS host.
	admin 0.0.0.0:2019
	metrics {
		per_host
	}
}

(production_common) {
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Strict-Transport-Security "max-age=15552000"
	}
	request_body @standard_body {
		max_size 20MB
	}
	@standard_body not path /api/documents/upload
	request_body /api/documents/upload {
		max_size 95MB
	}
	log {
		output file /var/log/caddy/access.json {
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format filter {
			wrap json
			fields {
				# The GUI capability is a WebSocket subprotocol, not a URL token.
				request>headers>Sec-Websocket-Protocol delete
				resp_headers>Sec-Websocket-Protocol delete
			}
		}
	}
}

coveedu.com {
	import production_common
	reverse_proxy home:3100
}

# `www` is not a second home for the marketing site. Two hostnames serving
# identical content split search ranking and cookies, and the apex is the
# canonical name every in-app link already uses. The redirect is permanent
# and preserves the path, so old Netlify-era `www` links keep working.
#
# Caddy still needs its own certificate for this name to terminate TLS before
# it can redirect, so the DNS record must point here for the block to work.
www.coveedu.com {
	redir https://coveedu.com{uri} permanent
}

cs.coveedu.com {
	import production_common
	@turtle_display {
		path_regexp turtle ^/gui/sessions/[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}/display$
		method GET
		header Upgrade websocket
	}
	handle @turtle_display {
		uri strip_prefix /gui
		reverse_proxy gui-service:4010 {
			transport http {
				read_timeout 35m
				write_timeout 35m
			}
		}
	}
	# Public clients cannot reach the broker's REST control plane or health.
	handle /gui/* {
		respond 404
	}
	handle {
		reverse_proxy studio:3000 {
			transport http {
				read_timeout 10m
				write_timeout 10m
			}
		}
	}
}

api.coveedu.com {
	import production_common
	reverse_proxy api:4000 {
		transport http {
			read_timeout 10m
			write_timeout 10m
		}
	}
}

mvp.coveedu.com {
	import production_common
	reverse_proxy mvp:3200
}
