NODE_ENV=production
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
NEXT_PUBLIC_API_URL=https://api.coveedu.com/api/rpc
NEXT_PUBLIC_SITE_URL=https://cs.coveedu.com
BFF_SHARED_SECRET=replace_with_same_api_bff_secret
NEXT_PUBLIC_KAKAO_AUTH_ENABLED=false
# Google availability is baked into the web image; changing this needs a rebuild.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
NEXT_PUBLIC_NAVER_AUTH_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_with_turnstile_site_key

# Baked into the web image; keep false until the separate GUI service is ready.
NEXT_PUBLIC_GUI_ENABLED=false

# Build-time flag; rebuild the studio image when changing it.
NEXT_PUBLIC_SHORT_ANSWER_ENABLED=false
NEXT_PUBLIC_MULTIPLE_CHOICE_ENABLED=false
NEXT_PUBLIC_VIDEO_LESSONS_ENABLED=false

# Runtime server flag; must agree with API. No DLAB secrets in Studio/browser.
DLAB_SSO_ENABLED=false

NEXT_PUBLIC_TURTLE_TRIAL_ENABLED=false
# Runtime kill switch, independently controlled by deployment.env in production.
TURTLE_TRIAL_ENABLED=false

# Optional server-only full RPC URL. Production Compose supplies the private API address.
# INTERNAL_API_RPC_URL=http://localhost:4000/api/rpc
