# Cove Studio v2 web application. Copy to .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_publishable_key
# Server-only key used by trusted web server actions. Never prefix it with
# NEXT_PUBLIC_ and never supply it as a Docker build argument.
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
NEXT_PUBLIC_API_URL=http://localhost:4000/api/rpc
# Production value. Use http://localhost:3000 in local development.
NEXT_PUBLIC_SITE_URL=https://cs.coveedu.com

# Must match the API value. Server-only; never expose this as NEXT_PUBLIC_*.
BFF_SHARED_SECRET=replace_with_at_least_32_random_bytes

# Kakao sign-in. Only the exact string "true" shows the Kakao button; keep it
# false until the Kakao provider release gate in
# docs/superpowers/specs/2026-08-21-password-recovery-and-kakao-availability-design.md
# passes. Kakao's own secrets belong in Kakao Developers and Supabase, never here.
NEXT_PUBLIC_KAKAO_AUTH_ENABLED=false

# Cloudflare Turnstile site key for password sign-in, sign-up, and recovery.
# Leave empty only in local environments where Supabase CAPTCHA protection is off.
# Configure the matching Turnstile secret in Supabase, never in the web app.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
