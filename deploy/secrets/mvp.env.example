NODE_ENV=production
NEXT_PUBLIC_SUPABASE_URL=https://OLD_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_old_publishable_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_old_service_role_key
# Signs the MVP's own session cookie. Reuse the value the MVP already
# ran with, or every existing login is invalidated at once. Sign-in
# fails only after the password verifies without it, which reads to a
# user as a network error rather than a configuration fault.
JWT_SECRET=replace_with_existing_mvp_jwt_secret
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=replace_with_judge0_key
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
JUDGE0_PYTHON_LANGUAGE_ID=71
JUDGE_CALLBACK_BASE_URL=https://mvp.coveedu.com
