{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "removeComments": true,
    "sourceMap": true,
    "target": "ES2023"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
