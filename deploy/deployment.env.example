# Non-secret deployment manifest. Copy to deployment.env on the VPS and pin
# every application to an immutable GHCR commit-SHA tag.
HOME_IMAGE=ghcr.io/dlabmapo-web/cove-home:sha-replace
STUDIO_IMAGE=ghcr.io/dlabmapo-web/cove-studio:sha-replace
API_IMAGE=ghcr.io/dlabmapo-web/cove-api:sha-replace
JUDGE_IMAGE=ghcr.io/dlabmapo-web/cove-judge:sha-replace
MIGRATION_IMAGE=ghcr.io/dlabmapo-web/cove-migration:sha-replace
VIDEO_WORKER_IMAGE=ghcr.io/dlabmapo-web/cove-video-worker:sha-replace
GUI_SERVICE_IMAGE=ghcr.io/dlabmapo-web/cove-gui-service:sha-replace
GUI_RUNTIME_IMAGE=ghcr.io/dlabmapo-web/cove-gui-runtime:sha-replace
MVP_IMAGE=ghcr.io/dlabmapo-web/cove-mvp:sha-replace

ACME_EMAIL=operator@example.com
JUDGE_CONCURRENCY=2
# Optional private case timing logs; never logs code, inputs or outputs.
JUDGE_TRACE_TIMINGS=false

# Selected with compatible API/Studio images; old manifests restore the old OS.
DLAB_OS_BASE_URL=https://os.dlabcampus.com/v1

# Release-controlled admission flags also select the optional runtime profiles.
# Older manifests omit these keys and therefore roll back to disabled admission.
GUI_ENABLED=false
SHORT_ANSWER_ENABLED=false
MULTIPLE_CHOICE_ENABLED=false
VIDEO_LESSONS_ENABLED=false

# Public trial admission; guest execution is on a SEPARATE daemon/host.
TURTLE_TRIAL_ENABLED=false
# Private WireGuard/VPC guest broker address; never the course gui-service.
TURTLE_TRIAL_DISPLAY_UPSTREAM=127.0.0.1:9

# Public browser Turtle pilot. Both switches stay off until staging acceptance.
# Keep these in the release manifest; Compose overrides any secret-file values.
TURTLE_TRIAL_BROWSER_ENABLED=false
TURTLE_TRIAL_BROWSER_ADMISSION_ENABLED=false
# TURTLE_TRIAL_BROWSER_RUNTIME_ORIGIN=https://turtle-runtime.coveedu.com
# TURTLE_TRIAL_BROWSER_RUNTIME_ID=brython-3.15.0-<20-character content hash from the approved web image>
TURTLE_TRIAL_BROWSER_PARENT_ORIGIN=https://cs.coveedu.com
TURTLE_TRIAL_BROWSER_RETAINED_RUNTIME_IDS=
TURTLE_TRIAL_BROWSER_PILOT_ACADEMY_IDS=
