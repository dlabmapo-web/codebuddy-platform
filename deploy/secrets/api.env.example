NODE_ENV=production
PORT=4000
WEB_ORIGIN=https://cs.coveedu.com
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=replace_with_secret
BFF_SHARED_SECRET=replace_with_at_least_32_random_bytes
DATABASE_URL=postgresql://replace_with_supavisor_runtime_connection
DIRECT_URL=postgresql://replace_with_direct_migration_connection
REDIS_URL=redis://:replace_with_redis_password@redis:6379/0
MONITORING_REDIS_URL=redis://:replace_with_redis_password@redis:6379/1
MONITORING_STREAM_MAX_LENGTH=10000
JUDGE_CONCURRENCY=2
PYODIDE_VERSION=0.27.5
SUBMISSION_RATE_LIMIT=10
EMAIL_API_KEY=re_replace_with_restricted_api_key
EMAIL_FROM="Cove Studio <no-reply@mail.coveedu.com>"
EMAIL_WEBHOOK_SECRET=whsec_replace_with_signing_secret
PLATFORM_ORGANIZATION_SLUG=cove

GUI_ENABLED=false
# GUI_SERVICE_URL=https://gui-control.internal.example
# GUI_SERVICE_SECRET=replace_with_a_shared_random_secret
# GUI_PUBLIC_WS_URL=wss://gui.example.com

# Short answers do not require the GUI service.
SHORT_ANSWER_ENABLED=false
MULTIPLE_CHOICE_ENABLED=false
VIDEO_LESSONS_ENABLED=false
VIDEO_MAX_UPLOAD_BYTES=5000000000
VIDEO_COURSE_QUOTA_BYTES=100000000000

# DLAB OS SSO: keep disabled until migration, verified campus mapping, and test setup.
DLAB_SSO_ENABLED=false
# allowlist requires explicit users; campus requires explicitly enabled campus mappings.
DLAB_SSO_ROLLOUT_MODE=allowlist
DLAB_OS_BASE_URL=https://os.dlabcampus.com/v1
DLAB_CLIENT_ID=cove
DLAB_REDIRECT_URI=https://cs.coveedu.com/sso/callback
# Set privately when enabling (never use NEXT_PUBLIC_).
# DLAB_CLIENT_SECRET=
# DLAB_INBOUND_SERVER_KEY=
# Explicit comma-separated external user IDs; empty permits no SSO users.
DLAB_SSO_ALLOWED_EXTERNAL_USER_IDS=
