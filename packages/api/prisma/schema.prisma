generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  USER
  ADMIN
}

enum UserStatus {
  PENDING_PROFILE
  ACTIVE
  SUSPENDED
  DELETED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum AcademyStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// What an academy is for.
///
/// A `LIBRARY` is platform-owned curriculum: it holds courses and nothing
/// else — no members, no classes, no students, no invitations. Its authority
/// comes from the platform permission axis rather than from memberships, and
/// every listing that means "the platform's customers" filters it out.
enum AcademyKind {
  ACADEMY
  LIBRARY
}

enum AcademyRole {
  STUDENT
  TEACHER
  TEAM_LEAD
  MANAGER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  LEFT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum OAuthOnboardingIntentStatus {
  PENDING
  CONSUMED
  EXPIRED
}

enum ClassStatus {
  ACTIVE
  ARCHIVED
}

/// Per-academy rollout switches. An enum rather than a free string so a typo
/// cannot read as "off" for every academy at once.
enum AcademyFeature {
  TEACHER_LIVE_MONITORING
  /// Whether students may see where they sit in their class.
  ///
  /// Off unless an academy turns it on. §9.7 of the student academy overview
  /// design — this is the only student surface that says anything about
  /// another student, and an academy that has not asked for it should not have
  /// to discover it after the fact.
  STUDENT_CLASS_STANDING
  /// The point ledger, the points page, and all awarding. Off means no row is
  /// ever written, so an academy that does not want a point economy pays
  /// nothing for one.
  STUDENT_POINTS
  /// The named class board. Requires STUDENT_POINTS, and replaces
  /// STUDENT_CLASS_STANDING where both are on — two comparison surfaces
  /// computed differently would eventually disagree. §18.2 of the student
  /// points design.
  STUDENT_CLASS_LEADERBOARD
}

/// Why one student earned points.
///
/// Every value here names a fact the server observed. There is no reason code
/// for a granted point and none for a penalty: points cannot be awarded by a
/// person and cannot be deducted by anyone. §5.2 and §7.6 of the student
/// points design.
enum PointReason {
  ATTENDANCE
  ATTENDANCE_LATE
  LEARNING_TIME
  EXERCISE_SOLVED
  LECTURE_COMPLETED
  MODULE_COMPLETED
  COURSE_COMPLETED
}

/// Why one teacher's watch of one student ended. Recorded on the visit and
/// sent to both clients, so a revoked teacher sees a reason instead of a
/// silent disconnection.
enum MonitoringVisitEndReason {
  TEACHER_LEFT
  WATCH_REPLACED
  STUDENT_LEFT
  ASSIGNMENT_CHANGED
  CLASS_ARCHIVED
  ENROLLMENT_REMOVED
  MEMBERSHIP_INACTIVE
  ROLE_CHANGED
  MATERIAL_UNAVAILABLE
  CONNECTION_EXPIRED
  FEATURE_DISABLED
  /// The platform suspended the whole academy. The connection guard runs once
  /// at connect time, so an open watch outlives a suspension unless the
  /// lifecycle service closes it explicitly.
  ACADEMY_SUSPENDED
}

enum MaterialType {
  PROGRAMMING_EXERCISE
}

enum ExerciseDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ExerciseLanguage {
  PYTHON
}

enum TestCaseVisibility {
  SAMPLE
  HIDDEN
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  /// Judge fault. Never counted against the student's attempts.
  ERRORED
  CANCELLED
}

enum CaseOutcome {
  PASSED
  WRONG_OUTPUT
  RUNTIME_ERROR
  TIME_LIMIT
  MEMORY_LIMIT
  /// Not run, because an earlier case already failed.
  SKIPPED
}

/// What a stored image is *for*. The purpose decides which relation may own
/// the asset and which authorization rule delivers it, so it is an enum rather
/// than a free string: a typo must not silently create a fourth category that
/// no read rule covers.
enum MediaAssetPurpose {
  USER_AVATAR
  ACADEMY_MEMBER_AVATAR
  /// Academy presentation images. Separate values so upload validation cannot
  /// confuse a member's avatar with the academy's own cover — the two have
  /// different aspect ratios and, more importantly, different readers.
  ACADEMY_COVER
  ACADEMY_GALLERY
}

/// Which academy image a media asset is.
enum AcademyMediaKind {
  COVER
  GALLERY
}

/// Where an import session is in its life.
///
/// `PREVIEW_READY` is the only state a commit may start from, and `COMMITTING`
/// is what stops two tabs committing the same workbook twice.
enum PeopleImportStatus {
  PREVIEW_READY
  COMMITTING
  COMPLETED
  EXPIRED
  FAILED
}

/// What a bulk operation does. Named rather than free text so a new kind is a
/// migration and a decision, not a string somebody passed.
/// The lifecycle of one curriculum import.
///
/// The same five states the member importer uses, and for the same reason:
/// PREVIEW_READY is the only one a commit may claim, and claiming it is a
/// conditional update, so two tabs holding one preview produce one winner
/// rather than two imports.
enum ContentImportStatus {
  PREVIEW_READY
  COMMITTING
  COMPLETED
  EXPIRED
  FAILED
}

enum PeopleBulkKind {
  ENROLL
  ROLE_CHANGE
  SUSPEND
  RESTORE
}

enum PeopleBulkStatus {
  PENDING
  COMPLETED
  FAILED
}

/// How far one email got.
///
/// Deliberately distinct from `InvitationStatus`: an invitation can be pending
/// while its email bounced, and accepted while its email is still only
/// `SENT`. Collapsing the two would make the interface claim provider evidence
/// it does not have.
enum InvitationDeliveryState {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  FAILED
}

/// How a guardian relates to a student. `OTHER` exists so the alternative is
/// not a free-text column that quietly collects names and phone numbers.
enum GuardianRelationship {
  MOTHER
  FATHER
  GRANDPARENT
  SIBLING
  LEGAL_GUARDIAN
  OTHER
}

enum ExerciseProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  SOLVED
}

model User {
  id                 String       @id @default(uuid()) @db.Uuid
  authUserId         String?      @unique @map("auth_user_id") @db.Uuid
  email              String?      @unique
  /// Sign-in name. Lowercase, globally unique, and never reused as a rename
  /// handle. Null for accounts that arrived through OAuth or predate it.
  username           String?      @unique
  displayName        String?      @map("display_name")
  /// The external OAuth photo, kept as a fallback only. Once a Cove image
  /// exists, `avatarAssetId` is authoritative and this is never consulted.
  /// A signed delivery URL is never written here — it would outlive the
  /// authorization that produced it.
  avatarUrl          String?      @map("avatar_url")
  /// The Cove-owned, privately stored profile image.
  avatarAssetId      String?      @map("avatar_asset_id") @db.Uuid
  /// Not a sign-in credential. Stored in canonical international form; the
  /// client formats it for the reader's locale.
  contactPhone       String?      @map("contact_phone")
  /// The locale the account reads Cove in, independent of any academy.
  preferredLocale    String       @default("ko") @map("preferred_locale")
  /// An IANA zone name. Null means "follow the browser", which is the right
  /// default for a student who has never thought about it.
  timezone           String?
  platformRole       PlatformRole @default(USER) @map("platform_role")
  status             UserStatus   @default(PENDING_PROFILE)
  legacyUserId       String?      @unique @map("legacy_user_id")
  legacyUsername     String?      @unique @map("legacy_username")
  legacyPasswordHash String?      @map("legacy_password_hash")
  migratedAt         DateTime?    @map("migrated_at") @db.Timestamptz(6)
  lastSignInAt       DateTime?    @map("last_sign_in_at") @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships           AcademyMembership[]
  invitationsCreated    AcademyInvitation[]       @relation("InvitationCreator")
  invitationsAccepted   AcademyInvitation[]       @relation("InvitationAcceptor")
  joinRequests          AcademyJoinRequest[]      @relation("JoinRequester")
  joinRequestsReviewed  AcademyJoinRequest[]      @relation("JoinReviewer")
  membershipInvitations AcademyMembership[]       @relation("MembershipInviter")
  membershipApprovals   AcademyMembership[]       @relation("MembershipApprover")
  auditLogs             AuditLog[]                @relation("AuditActor")
  coursesCreated        Course[]                  @relation("CourseCreator")
  classesCreated        Class[]                   @relation("ClassCreator")
  classCoursesAssigned  ClassCourse[]             @relation("ClassCourseAssigner")
  classEnrollmentsMade  ClassEnrollment[]         @relation("ClassEnroller")
  exerciseDrafts        ExerciseDraft[]
  submissions           Submission[]
  exerciseProgress      StudentExerciseProgress[]
  solveSessions         ExerciseSolveSession[]
  avatarAsset           MediaAsset?               @relation("UserAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  mediaUploaded         MediaAsset[]              @relation("MediaUploader")
  peopleImports         PeopleImportSession[]     @relation("PeopleImportActor")
  contentImports        ContentImportSession[]    @relation("ContentImportActor")
  peopleBulkOperations  PeopleBulkOperation[]     @relation("PeopleBulkActor")
  academiesCreated      Academy[]                 @relation("AcademyCreator")
  supportGrants         PlatformSupportGrant[]    @relation("SupportGrantAdmin")
  supportGrantsRevoked  PlatformSupportGrant[]    @relation("SupportGrantRevoker")

  @@index([status])
  @@map("users")
}

/// One stored object in the private profile-image bucket.
///
/// The row is metadata and ownership; the bytes live in Supabase Storage and
/// the delivery URL is minted per request. `uploaderUserId` records who
/// performed the upload and decides nothing about who may view it — a manager
/// who uploads a student's photo does not thereby own it, and the student does
/// not lose it when that manager leaves.
model MediaAsset {
  id             String            @id @default(uuid()) @db.Uuid
  bucket         String
  /// Immutable, and scoped by business identity. Replacing a photo writes a
  /// new object and repoints the relation; it never overwrites in place, so a
  /// failed upload cannot destroy the picture already on the profile.
  objectKey      String            @unique @map("object_key")
  purpose        MediaAssetPurpose
  uploaderUserId String            @map("uploader_user_id") @db.Uuid
  contentType    String            @map("content_type")
  sizeBytes      Int               @map("size_bytes")
  width          Int
  height         Int
  checksumSha256 String            @map("checksum_sha256")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Set when a newer asset replaced this one. Cleanup deletes the object
  /// after the grace period, so a transient failure stays recoverable.
  supersededAt   DateTime?         @map("superseded_at") @db.Timestamptz(6)
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz(6)

  uploader      User                   @relation("MediaUploader", fields: [uploaderUserId], references: [id], onDelete: Restrict)
  userAvatars   User[]                 @relation("UserAvatar")
  memberAvatars AcademyMemberProfile[] @relation("AcademyMemberAvatar")
  academyMedia  AcademyMedia[]         @relation("AcademyMedia")

  /// The cleanup sweep: superseded and orphaned objects, oldest first.
  @@index([supersededAt, createdAt])
  @@index([purpose, createdAt])
  @@map("media_assets")
}

/// The academy-scoped presentation of one member, whatever their role.
///
/// Keyed by membership rather than user, which is the boundary the whole
/// feature rests on: one account can be a student in Mapo and a teacher in
/// Gangnam, and neither academy's manager may edit the other's view of them.
/// Every field here is an *override* — a null reveals the global value rather
/// than blanking it.
model AcademyMemberProfile {
  membershipId       String   @id @map("membership_id") @db.Uuid
  academyDisplayName String?  @map("academy_display_name")
  avatarAssetId      String?  @map("avatar_asset_id") @db.Uuid
  contactPhone       String?  @map("contact_phone")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  membership  AcademyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  avatarAsset MediaAsset?       @relation("AcademyMemberAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)

  @@map("academy_member_profiles")
}

/// A student's academy record.
///
/// Created lazily on first edit, and never deleted by a role change: a member
/// promoted to teacher and later corrected back must not have lost their
/// guardian details in between. Endpoints return only the shape matching the
/// membership's current role, so a stale row is invisible until it is relevant
/// again.
model StudentAcademyProfile {
  membershipId          String                @id @map("membership_id") @db.Uuid
  /// Denormalized from the membership so academy-local uniqueness is a
  /// database constraint rather than a service that remembers to check.
  academyId             String                @map("academy_id") @db.Uuid
  dateOfBirth           DateTime?             @map("date_of_birth") @db.Date
  schoolName            String?               @map("school_name")
  schoolGrade           String?               @map("school_grade")
  guardianName          String?               @map("guardian_name")
  guardianRelationship  GuardianRelationship? @map("guardian_relationship")
  guardianPhone         String?               @map("guardian_phone")
  emergencyContactName  String?               @map("emergency_contact_name")
  emergencyContactPhone String?               @map("emergency_contact_phone")
  /// The student's own words. A manager reads these and does not rewrite them.
  codingInterests       String[]              @map("coding_interests")
  learningGoal          String?               @map("learning_goal")
  /// Manager-owned, and unique only inside one academy.
  studentNumber         String?               @map("student_number")
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  membership AcademyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  /// Postgres treats NULLs as distinct, so every student without a number
  /// coexists and only two identical numbers collide.
  @@unique([academyId, studentNumber])
  @@map("student_academy_profiles")
}

/// One shape for `TEACHER`, `TEAM_LEAD`, and `MANAGER`.
///
/// Those roles differ in authority, not in biography. Three near-identical
/// models would only give a field three places to drift, and the profile never
/// implies a permission — the authorization map still decides that.
model StaffAcademyProfile {
  membershipId      String   @id @map("membership_id") @db.Uuid
  /// Denormalized for the same reason as the student profile's copy.
  academyId         String   @map("academy_id") @db.Uuid
  bio               String?
  specialties       String[]
  teachingLanguages String[] @map("teaching_languages")
  /// Manager-owned: what the academy says this person is responsible for.
  academyTitle      String?  @map("academy_title")
  employeeNumber    String?  @map("employee_number")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  membership AcademyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([academyId, employeeNumber])
  @@map("staff_academy_profiles")
}

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  academies Academy[]

  @@map("organizations")
}

model Academy {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String
  slug           String
  status         AcademyStatus @default(ACTIVE)
  /// Defaulted, so every academy that existed before the content library is
  /// correct without a backfill.
  kind           AcademyKind   @default(ACADEMY)

  /// Where the academy is, as a manager would write it on a letter. Every
  /// part is nullable because an academy exists before anyone fills its
  /// profile in, and a required column would have to be backfilled with a
  /// placeholder that reads like an answer.
  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")
  locality     String?
  region       String?
  postalCode   String? @map("postal_code")
  /// ISO 3166-1 alpha-2, upper case. Stored rather than assumed so an academy
  /// outside Korea is a data change and not a code change.
  countryCode  String? @map("country_code") @db.Char(2)

  contactPhone String? @map("contact_phone")
  contactEmail String? @map("contact_email")

  /// The authoritative academy-local day boundary.
  ///
  /// `ACADEMY_TIME_ZONE` in `@cove/shared` was the placeholder for exactly
  /// this column: every period, growth bucket, and "today" on a manager or
  /// teacher surface is drawn here. Defaulted to Seoul so existing rows keep
  /// the behaviour they already had.
  timeZone String @default("Asia/Seoul") @map("time_zone")

  /// When a manager last edited the profile above. Null means never — which
  /// is what the completion prompt on the overview asks about.
  profileUpdatedAt DateTime? @map("profile_updated_at") @db.Timestamptz(6)

  /// When the platform last moved this academy between ACTIVE, SUSPENDED, and
  /// ARCHIVED. Null means it has been ACTIVE since it was created.
  ///
  /// One column rather than the `archivedAt` shape `Class` uses: a class has a
  /// single terminal state, whereas an academy has two plus a reversible one,
  /// so a timestamp per state would need a rule about which one wins after a
  /// suspend-then-archive. The *reason* for the move lives on the audit record.
  statusChangedAt DateTime? @map("status_changed_at") @db.Timestamptz(6)

  /// The platform admin who onboarded this academy.
  ///
  /// Nullable because every academy that predates platform administration was
  /// seeded and has no creator. SetNull so removing a departed operator's
  /// account never blocks on an academy they once created.
  createdByUserId String? @map("created_by_user_id") @db.Uuid

  /// Bumped inside the transaction of every membership, invitation, and
  /// enrollment change.
  ///
  /// A directory selection or an import preview carries the revision it was
  /// built against, so a bulk mutation raised against a roster that has since
  /// moved is a visible conflict rather than a silent overwrite of whoever
  /// arrived in between.
  peopleRevision Int @default(0) @map("people_revision")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization           Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy              User?                           @relation("AcademyCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  memberships            AcademyMembership[]
  slugHistory            AcademySlugHistory[]
  invitations            AcademyInvitation[]
  joinRequests           AcademyJoinRequest[]
  oauthOnboardingIntents OAuthOnboardingIntent[]
  auditLogs              AuditLog[]
  courses                Course[]
  classes                Class[]
  featureFlags           AcademyFeatureFlag[]
  monitoringVisits       TeacherMonitoringVisit[]
  teacherFeedback        TeacherFeedback[]
  learningDays           StudentCourseLearningDay[]
  classLearningDays      StudentClassCourseLearningDay[]
  media                  AcademyMedia[]
  importSessions         PeopleImportSession[]
  contentImportSessions  ContentImportSession[]
  bulkOperations         PeopleBulkOperation[]
  pointAwards            PointAward[]
  pointPolicy            AcademyPointPolicy?
  supportGrants          PlatformSupportGrant[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  /// The platform academy list's default ordering, newest first within a state.
  @@index([status, createdAt(sort: Desc)])
  @@map("academies")
}

/// One rollout switch for one academy.
///
/// A missing row means off: enabling a feature is always a deliberate write,
/// so a new academy never starts inside a staged rollout.
model AcademyFeatureFlag {
  academyId String         @map("academy_id") @db.Uuid
  feature   AcademyFeature
  isEnabled Boolean        @default(false) @map("is_enabled")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  @@id([academyId, feature])
  @@map("academy_feature_flags")
}

model OAuthOnboardingIntent {
  id                   String                      @id @default(uuid()) @db.Uuid
  tokenHash            String                      @unique @map("token_hash")
  academyId            String                      @map("academy_id") @db.Uuid
  provider             String
  status               OAuthOnboardingIntentStatus @default(PENDING)
  expiresAt            DateTime                    @map("expires_at") @db.Timestamptz(6)
  consumedAt           DateTime?                   @map("consumed_at") @db.Timestamptz(6)
  consumedByAuthUserId String?                     @map("consumed_by_auth_user_id") @db.Uuid
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([academyId, createdAt])
  @@map("oauth_onboarding_intents")
}

/// A slug this academy used to answer to.
///
/// The slug is in every URL an academy has appeared in — a student's bookmark
/// mid-course, a link a teacher emailed, an invitation already sent. Retiring
/// one without remembering it breaks all of them at once, which is why nobody
/// would risk a rename.
///
/// The slug is the primary key: a retired slug can only ever have pointed at
/// one academy, and that is a claim the database should hold rather than a
/// convention the services agree to keep.
model AcademySlugHistory {
  slug      String   @id
  academyId String   @map("academy_id") @db.Uuid
  retiredAt DateTime @default(now()) @map("retired_at") @db.Timestamptz(6)

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  @@index([academyId])
  @@map("academy_slug_history")
}

model AcademyMembership {
  id               String           @id @default(uuid()) @db.Uuid
  academyId        String           @map("academy_id") @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  role             AcademyRole
  status           MembershipStatus @default(INVITED)
  invitedByUserId  String?          @map("invited_by_user_id") @db.Uuid
  approvedByUserId String?          @map("approved_by_user_id") @db.Uuid
  joinedAt         DateTime?        @map("joined_at") @db.Timestamptz(6)
  suspendedAt      DateTime?        @map("suspended_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  academy          Academy           @relation(fields: [academyId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy        User?             @relation("MembershipInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  approvedBy       User?             @relation("MembershipApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  classEnrollments ClassEnrollment[]
  assignedClasses  Class[]           @relation("ClassTeacher")

  monitoringVisitsAsTeacher TeacherMonitoringVisit[]        @relation("MonitoringVisitTeacher")
  monitoringVisitsAsStudent TeacherMonitoringVisit[]        @relation("MonitoringVisitStudent")
  feedbackAuthored          TeacherFeedback[]               @relation("TeacherFeedbackAuthor")
  feedbackReceived          TeacherFeedback[]               @relation("TeacherFeedbackRecipient")
  learningDays              StudentCourseLearningDay[]
  classLearningDays         StudentClassCourseLearningDay[]
  pointAwards               PointAward[]
  pointBalance              StudentPointBalance?
  memberProfile             AcademyMemberProfile?
  studentProfile            StudentAcademyProfile?
  staffProfile              StaffAcademyProfile?

  @@unique([academyId, userId])
  @@index([userId, status])
  @@index([academyId, role, status])
  /// The people directory's default order, inside one academy.
  @@index([academyId, updatedAt(sort: Desc), id], map: "academy_memberships_academy_updated_idx")
  /// Student growth, bucketed by the local day a membership became active.
  @@index([academyId, role, status, joinedAt], map: "academy_memberships_academy_joined_idx")
  /// The platform people directory: one role across every academy.
  ///
  /// The first index here that does not lead with `academyId`, and it has to
  /// be. Every other read in the product is already inside one academy; the
  /// console's is "every teacher on Cove", which none of them can serve.
  @@index([role, status], map: "academy_memberships_role_status_idx")
  @@map("academy_memberships")
}

model AcademyInvitation {
  id               String           @id @default(uuid()) @db.Uuid
  academyId        String           @map("academy_id") @db.Uuid
  email            String
  role             AcademyRole
  tokenHash        String           @unique @map("token_hash")
  /// The name an import suggested for this person, if one did.
  ///
  /// A hint, never an instruction: import must not rename a global account,
  /// because the account belongs to the person and not to the academy. On
  /// acceptance it seeds the academy-scoped display-name override, and only
  /// when the recipient has not set one themselves.
  displayNameHint  String?          @map("display_name_hint")
  status           InvitationStatus @default(PENDING)
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(6)
  invitedByUserId  String           @map("invited_by_user_id") @db.Uuid
  acceptedByUserId String?          @map("accepted_by_user_id") @db.Uuid
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz(6)
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  academy          Academy                     @relation(fields: [academyId], references: [id], onDelete: Cascade)
  invitedBy        User                        @relation("InvitationCreator", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy       User?                       @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  deliveryAttempts InvitationDeliveryAttempt[]

  @@index([academyId, email, status])
  @@index([expiresAt, status])
  @@map("academy_invitations")
}

/// One academy presentation image, in its slot.
///
/// A join row rather than a column on `Academy` because a gallery is a list
/// and a cover is a list of one, and both want the same replacement behaviour:
/// point at a new immutable asset, mark the old one superseded, let the sweep
/// delete it after the grace period.
model AcademyMedia {
  id           String           @id @default(uuid()) @db.Uuid
  academyId    String           @map("academy_id") @db.Uuid
  assetId      String           @map("asset_id") @db.Uuid
  kind         AcademyMediaKind
  /// Gallery order. Always 0 for a cover, which is what makes the unique
  /// constraint below enforce "at most one cover" without a second rule.
  position     Int              @default(0)
  /// Required unless the manager explicitly marked the image decorative.
  altText      String?          @map("alt_text")
  isDecorative Boolean          @default(false) @map("is_decorative")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  academy Academy    @relation(fields: [academyId], references: [id], onDelete: Cascade)
  asset   MediaAsset @relation("AcademyMedia", fields: [assetId], references: [id], onDelete: Restrict)

  @@index([academyId, kind, position])
  @@map("academy_media")
}

/// One uploaded member workbook, from parse to commit.
///
/// The normalized preview is stored rather than recomputed so the rows a
/// manager acknowledged are exactly the rows that commit — re-parsing at commit
/// would silently apply a different normalization if the code changed between
/// the two requests.
///
/// `capturedPeopleRevision` is the concurrency check: a roster that moved while
/// the preview sat on screen produces a conflict and a fresh preview rather
/// than a commit against people who arrived in between.
model PeopleImportSession {
  id                     String             @id @default(uuid()) @db.Uuid
  academyId              String             @map("academy_id") @db.Uuid
  actorUserId            String             @map("actor_user_id") @db.Uuid
  originalFilename       String             @map("original_filename")
  /// SHA-256 of the uploaded bytes. Two uploads of the same file inside one
  /// session window are the same session rather than two.
  checksumSha256         String             @map("checksum_sha256")
  status                 PeopleImportStatus @default(PREVIEW_READY)
  totalRows              Int                @map("total_rows")
  readyRows              Int                @map("ready_rows")
  warningRows            Int                @map("warning_rows")
  errorRows              Int                @map("error_rows")
  /// The normalized rows and their verdicts. Bounded by the 500-row cap.
  preview                Json
  capturedPeopleRevision Int                @map("captured_people_revision")
  expiresAt              DateTime           @map("expires_at") @db.Timestamptz(6)
  /// Unique per academy: a retried commit returns the original result rather
  /// than inviting everybody twice.
  idempotencyKey         String             @map("idempotency_key")
  committedAt            DateTime?          @map("committed_at") @db.Timestamptz(6)
  /// Row-level outcomes, written at commit and downloadable as CSV.
  result                 Json?
  failureCode            String?            @map("failure_code")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  actor   User    @relation("PeopleImportActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([academyId, idempotencyKey])
  @@index([academyId, status, createdAt])
  @@index([expiresAt])
  @@map("people_import_sessions")
}

/// One curriculum import, from the moment the workbook was read to the receipt
/// it leaves behind.
///
/// Durable rather than cached, for the case that makes an importer dangerous:
/// the transaction committed and the response was lost on the wire. A retry has
/// to be able to learn that forty problems already exist, and a session held in
/// memory could not answer that after a deploy — the team lead would be shown a
/// preview of changes that had already been applied.
///
/// Scoped to one course as well as one academy. Every read filters on both, and
/// a session belonging to another course is reported with the same code as one
/// that never existed, so an id cannot be probed for existence across a course
/// or tenant boundary.
model ContentImportSession {
  id                      String              @id @default(uuid()) @db.Uuid
  academyId               String              @map("academy_id") @db.Uuid
  courseId                String              @map("course_id") @db.Uuid
  actorUserId             String              @map("actor_user_id") @db.Uuid
  originalFilename        String              @map("original_filename")
  /// SHA-256 of the uploaded bytes, for the audit trail. The raw workbook is
  /// never stored: it holds hidden expected outputs and problem text, and a
  /// checksum answers "was this the same file" without keeping any of it.
  checksumSha256          String              @map("checksum_sha256")
  templateVersion         Int                 @map("template_version")
  status                  ContentImportStatus @default(PREVIEW_READY)
  createCount             Int                 @map("create_count")
  updateCount             Int                 @map("update_count")
  unchangedCount          Int                 @map("unchanged_count")
  warningCount            Int                 @map("warning_count")
  conflictCount           Int                 @map("conflict_count")
  errorCount              Int                 @map("error_count")
  /// The planned actions, exactly as the team lead reviewed them. Bounded by
  /// the 200-problem cap and the per-cell limits the reader enforces.
  plan                    Json
  /// §9.2 — the course revision the plan was computed against.
  capturedContentRevision Int                 @map("captured_content_revision")
  expiresAt               DateTime            @map("expires_at") @db.Timestamptz(6)
  /// Unique per course: a retried commit returns the original result rather
  /// than importing the workbook twice.
  idempotencyKey          String              @map("idempotency_key")
  committedAt             DateTime?           @map("committed_at") @db.Timestamptz(6)
  /// What the commit actually did, with the ids the result screen links to.
  result                  Json?
  failureCode             String?             @map("failure_code")
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  actor   User    @relation("ContentImportActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([courseId, idempotencyKey])
  @@index([academyId, courseId, status, createdAt])
  @@index([expiresAt])
  @@map("content_import_sessions")
}

/// One bulk mutation, and what it actually did.
///
/// Durable because §12 makes bulk operations idempotent: a retry with the same
/// key returns this row rather than running again, which is the only safe
/// answer when the first response was lost on the wire after the transaction
/// committed.
model PeopleBulkOperation {
  id             String           @id @default(uuid()) @db.Uuid
  academyId      String           @map("academy_id") @db.Uuid
  actorUserId    String           @map("actor_user_id") @db.Uuid
  kind           PeopleBulkKind
  /// The normalized selection: explicit ids, or a filter plus exclusions.
  selection      Json
  requestedCount Int              @map("requested_count")
  succeededCount Int              @default(0) @map("succeeded_count")
  failedCount    Int              @default(0) @map("failed_count")
  status         PeopleBulkStatus @default(PENDING)
  idempotencyKey String           @map("idempotency_key")
  /// Per-target outcomes, for the downloadable result.
  result         Json?
  failureCode    String?          @map("failure_code")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  actor   User    @relation("PeopleBulkActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([academyId, kind, idempotencyKey])
  @@index([academyId, createdAt])
  @@map("people_bulk_operations")
}

/// One attempt to deliver one invitation email.
///
/// Attempts accumulate rather than being overwritten: a resend is a new
/// attempt, and the history of a bounced address is what tells a manager the
/// address is wrong rather than the system being slow.
model InvitationDeliveryAttempt {
  id                String                  @id @default(uuid()) @db.Uuid
  invitationId      String                  @map("invitation_id") @db.Uuid
  attemptNumber     Int                     @map("attempt_number")
  /// The provider's own id, once it has accepted the message.
  providerMessageId String?                 @map("provider_message_id")
  state             InvitationDeliveryState @default(QUEUED)
  failureCode       String?                 @map("failure_code")
  queuedAt          DateTime                @default(now()) @map("queued_at") @db.Timestamptz(6)
  sentAt            DateTime?               @map("sent_at") @db.Timestamptz(6)
  deliveredAt       DateTime?               @map("delivered_at") @db.Timestamptz(6)
  failedAt          DateTime?               @map("failed_at") @db.Timestamptz(6)
  /// The provider event that last moved this attempt. Unique, so a webhook
  /// delivered twice — which every provider does — advances the state once.
  lastEventKey      String?                 @unique @map("last_event_key")
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  invitation AcademyInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@unique([invitationId, attemptNumber])
  @@index([state, queuedAt])
  @@index([providerMessageId])
  @@map("invitation_delivery_attempts")
}

model AcademyJoinRequest {
  id               String            @id @default(uuid()) @db.Uuid
  academyId        String            @map("academy_id") @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  message          String?
  status           JoinRequestStatus @default(PENDING)
  approvedRole     AcademyRole?      @map("approved_role")
  reviewedByUserId String?           @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  reviewReason     String?           @map("review_reason")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  academy    Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  user       User    @relation("JoinRequester", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("JoinReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([academyId, status, createdAt])
  @@index([userId, status])
  @@map("academy_join_requests")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  academyId   String?  @map("academy_id") @db.Uuid
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  before      Json?
  after       Json?
  requestId   String?  @map("request_id")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// The support grant this act was performed under, when it was one.
  ///
  /// Null for every ordinary act. Set for every write made while
  /// `AcademyAccessService` answered `via: "support"` — which is what makes
  /// the platform's grant page and the academy's own audit page tell the same
  /// story about the same edit.
  supportGrantId String? @map("support_grant_id") @db.Uuid

  actor        User?                 @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  academy      Academy?              @relation(fields: [academyId], references: [id], onDelete: SetNull)
  supportGrant PlatformSupportGrant? @relation(fields: [supportGrantId], references: [id], onDelete: SetNull)

  @@index([supportGrantId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([academyId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

/// One operator's time-limited authority inside one academy.
///
/// The bridge between the two authority axes, and the only one. It is a row
/// rather than a role because every property that makes deep access acceptable
/// — a stated reason, an end time, a revoke button, a trail — is a column here
/// and would be nothing at all in a permission-map entry.
///
/// See §3.2 of the platform admin console design.
model PlatformSupportGrant {
  id          String      @id @default(uuid()) @db.Uuid
  academyId   String      @map("academy_id") @db.Uuid
  adminUserId String      @map("admin_user_id") @db.Uuid

  /// Which role's permission set answers while this grant is live.
  ///
  /// Required, because `ManagerScopeService` and `LeadScopeService` assert an
  /// exact role after their permission check. A grant carrying permissions and
  /// no role would open half the academy surface and refuse the rest.
  assumedRole AcademyRole @map("assumed_role")

  /// Default true. False does not narrow anything — it widens — so it is the
  /// flag an operator has to reach for deliberately.
  readOnly Boolean @default(true) @map("read_only")

  /// Opt-in per grant. Live monitoring watches a named child's editor in real
  /// time, which is a different consent question from reading a stored
  /// submission and must not follow from picking TEACHER in a dropdown.
  allowMonitoring Boolean @default(false) @map("allow_monitoring")

  /// Required free text. This is what the academy reads on its own audit page,
  /// so it is written for them rather than for the operator.
  reason String

  startsAt  DateTime @default(now()) @map("starts_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  /// Restrict, matching `Course.createdBy`: an operator's account must not be
  /// removable while these rows record what they did with it.
  admin     User       @relation("SupportGrantAdmin", fields: [adminUserId], references: [id], onDelete: Restrict)
  revokedBy User?      @relation("SupportGrantRevoker", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  auditLogs AuditLog[]

  /// The authorization read, run on every academy request an operator makes:
  /// is there a live grant for this pair, right now.
  @@index([academyId, adminUserId, expiresAt])
  /// The console's history list, newest first.
  @@index([adminUserId, createdAt(sort: Desc)])
  @@map("platform_support_grants")
}

model Course {
  id              String   @id @default(uuid()) @db.Uuid
  academyId       String   @map("academy_id") @db.Uuid
  title           String
  description     String   @default("")
  isVisible       Boolean  @default(false) @map("is_visible")
  /// Bumped by every mutation anywhere in this course's content, in the same
  /// transaction as the mutation itself.
  ///
  /// `updatedAt` cannot do this job: adding a test case to a problem four
  /// levels down never touches the course row, so an import preview validated
  /// against `updatedAt` would survive an edit that invalidated it. An import
  /// captures this number, the browser round-trips it, and the commit compares
  /// it again while holding the course lock.
  contentRevision Int      @default(1) @map("content_revision")

  /// The library course this was copied from, or null for a course the academy
  /// authored itself.
  ///
  /// `Restrict`, not `SetNull`: the database refuses to delete a library course
  /// while copies of it exist, and head office is pointed at retiring it
  /// instead. Losing this pointer would lose the only record of where a
  /// branch's curriculum came from.
  sourceCourseId        String?   @map("source_course_id") @db.Uuid
  /// The master's `contentRevision` at the instant of copying. Compared
  /// against the master's current revision to decide whether head office has
  /// moved on since.
  sourceContentRevision Int?      @map("source_content_revision")
  /// This course's *own* `contentRevision` immediately after the copy
  /// transaction. Anything above it is the branch's own editing.
  ///
  /// Stored rather than assumed to be 1, so a later change to the copy path —
  /// one that bumps the revision while building the tree — cannot silently
  /// make every copy in the product read as customized.
  baselineRevision      Int?      @map("baseline_revision")
  /// Set only on a library course: withdrawn from the library, so no new
  /// copies may be taken and existing ones are marked. Null is the ordinary
  /// state for every course in the product.
  retiredAt             DateTime? @map("retired_at") @db.Timestamptz(6)

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  academy           Academy                         @relation(fields: [academyId], references: [id], onDelete: Restrict)
  createdBy         User                            @relation("CourseCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  sourceCourse      Course?                         @relation("CourseSource", fields: [sourceCourseId], references: [id], onDelete: Restrict)
  copies            Course[]                        @relation("CourseSource")
  modules           CourseModule[]
  exerciseDrafts    ExerciseDraft[]
  submissions       Submission[]
  classAssignments  ClassCourse[]
  learningDays      StudentCourseLearningDay[]
  classLearningDays StudentClassCourseLearningDay[]
  importSessions    ContentImportSession[]

  @@index([academyId, isVisible, updatedAt])
  /// The library fan-out: every academy's copy of one master.
  @@index([sourceCourseId])
  @@map("courses")
}

/// The delivery boundary between reusable curriculum and learners: a class
/// learns many courses, a course is taught to many classes, and a student may
/// sit in several classes of the same academy.
///
/// Names are intentionally not unique — an academy reuses "Level 1" every
/// term — so the UUID is the identity and the UI shows status for context.
model Class {
  id                  String      @id @default(uuid()) @db.Uuid
  academyId           String      @map("academy_id") @db.Uuid
  name                String
  description         String      @default("")
  status              ClassStatus @default(ACTIVE)
  createdByUserId     String      @map("created_by_user_id") @db.Uuid
  /// The one teacher responsible for this class, or null while unassigned.
  /// Deliberately not unique: one teacher runs many classes. It stores the
  /// membership rather than the user so academy scope and academy role are
  /// both explicit — but the key alone cannot prove same-academy, so every
  /// read and write still checks the academy in the query.
  teacherMembershipId String?     @map("teacher_membership_id") @db.Uuid
  archivedAt          DateTime?   @map("archived_at") @db.Timestamptz(6)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Touched by course and roster changes too, so the management list reports
  /// the most recent change of any kind rather than only the last rename.
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  academy           Academy                         @relation(fields: [academyId], references: [id], onDelete: Restrict)
  createdBy         User                            @relation("ClassCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  /// SetNull, not Cascade: deleting a membership must leave the class intact
  /// and merely unassigned. Suspension and role changes delete nothing, so a
  /// stale assignment stays visible to managers as unavailable.
  assignedTeacher   AcademyMembership?              @relation("ClassTeacher", fields: [teacherMembershipId], references: [id], onDelete: SetNull)
  courseAssignments ClassCourse[]
  enrollments       ClassEnrollment[]
  scheduleSlots     ClassScheduleSlot[]
  monitoringVisits  TeacherMonitoringVisit[]
  teacherFeedback   TeacherFeedback[]
  submissions       Submission[]
  solveSessions     ExerciseSolveSession[]
  learningDays      StudentClassCourseLearningDay[]
  pointAwards       PointAward[]

  @@index([academyId, status, updatedAt(sort: Desc)])
  @@index([academyId, name])
  /// Answers "which active classes is this teacher responsible for", the
  /// query the later monitoring design starts from.
  @@index([teacherMembershipId, status])
  @@map("classes")
}

/// One course taught to one class. Removing the row revokes access and never
/// touches drafts, submissions, or progress.
model ClassCourse {
  classId          String   @map("class_id") @db.Uuid
  courseId         String   @map("course_id") @db.Uuid
  assignedByUserId String   @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  class      Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignedBy User   @relation("ClassCourseAssigner", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@id([classId, courseId])
  @@index([courseId, classId])
  @@map("class_courses")
}

/// One student's seat in one class.
///
/// References the academy membership rather than the user: it makes academy
/// scope explicit and lets one person hold different roles in two academies.
/// A suspended or promoted membership stops granting access even while the
/// row remains, so a Manager can still see and clear a stale seat.
model ClassEnrollment {
  classId            String    @map("class_id") @db.Uuid
  membershipId       String    @map("membership_id") @db.Uuid
  enrolledByUserId   String    @map("enrolled_by_user_id") @db.Uuid
  enrolledAt         DateTime  @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  /// Contextual history for an offline roster label, throttled to at most one
  /// write a minute per student. Never a presence truth source: a timestamp
  /// cannot tell a closed laptop from a tab that is still open.
  lastLearningSeenAt DateTime? @map("last_learning_seen_at") @db.Timestamptz(6)

  class      Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  membership AcademyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  enrolledBy User              @relation("ClassEnroller", fields: [enrolledByUserId], references: [id], onDelete: Restrict)

  @@id([classId, membershipId])
  @@index([membershipId, classId])
  @@map("class_enrollments")
}

model CourseModule {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @map("course_id") @db.Uuid
  /// The import identity, stable across renaming and reordering.
  ///
  /// Manually created modules get a server-generated UUID key, which the
  /// generated workbook exposes — that is what lets a team lead edit content
  /// they made by hand through Excel without inventing a key for it. Never
  /// author-supplied outside an import: the manual create path has no column
  /// for it, so a hand-typed key cannot collide with an imported one.
  externalKey String   @map("external_key")
  title       String
  description String   @default("")
  position    Int
  /// Hidden modules stay in the curriculum but disappear for students.
  isVisible   Boolean  @default(false) @map("is_visible")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lectures Lecture[]

  @@unique([courseId, position])
  /// The database enforces module keys because it can: a module's course is one
  /// column away. Lecture and problem keys are course-unique too, but proving
  /// that needs the whole Material -> Lecture -> Module -> Course chain, so the
  /// import service enforces those while holding the course lock.
  @@unique([courseId, externalKey])
  @@index([courseId])
  @@map("course_modules")
}

model Lecture {
  id             String   @id @default(uuid()) @db.Uuid
  courseModuleId String   @map("course_module_id") @db.Uuid
  /// The import identity. Course-unique rather than module-unique: the
  /// Problems sheet references a lecture with no module column, so a key that
  /// was only unique inside its module would be ambiguous the moment two
  /// modules reused one.
  externalKey    String   @map("external_key")
  title          String
  description    String   @default("")
  position       Int
  /// Hidden lectures stay in the curriculum but disappear for students.
  isVisible      Boolean  @default(false) @map("is_visible")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  courseModule CourseModule @relation(fields: [courseModuleId], references: [id], onDelete: Cascade)
  materials    Material[]

  @@unique([courseModuleId, position])
  @@index([courseModuleId])
  @@index([externalKey])
  @@map("lectures")
}

model Material {
  id         String       @id @default(uuid()) @db.Uuid
  lectureId  String       @map("lecture_id") @db.Uuid
  type       MaterialType
  title      String
  position   Int
  isRequired Boolean      @default(true) @map("is_required")
  /// Hides a single material from students while preserving its work history.
  isVisible  Boolean      @default(false) @map("is_visible")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  lecture             Lecture                   @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  programmingExercise ProgrammingExercise?
  drafts              ExerciseDraft[]
  submissions         Submission[]
  progress            StudentExerciseProgress[]
  monitoringVisits    TeacherMonitoringVisit[]
  teacherFeedback     TeacherFeedback[]
  solveSessions       ExerciseSolveSession[]

  @@unique([lectureId, position])
  @@index([lectureId])
  @@map("materials")
}

model ProgrammingExercise {
  materialId        String             @id @map("material_id") @db.Uuid
  externalKey       String             @map("external_key")
  legacyProblemNo   Int?               @map("legacy_problem_no")
  difficulty        ExerciseDifficulty
  description       String             @default("")
  inputFormat       String             @default("") @map("input_format")
  outputFormat      String             @default("") @map("output_format")
  constraints       String             @default("")
  starterCode       String             @default("") @map("starter_code")
  solutionCode      String?            @map("solution_code") @db.Text
  language          ExerciseLanguage   @default(PYTHON)
  timeLimitMs       Int                @default(3000) @map("time_limit_ms")
  memoryLimitMb     Int                @default(256) @map("memory_limit_mb")
  aiFeedbackEnabled Boolean            @default(false) @map("ai_feedback_enabled")
  gradingRevision   Int                @default(1) @map("grading_revision")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  material  Material           @relation(fields: [materialId], references: [id], onDelete: Cascade)
  testCases ExerciseTestCase[]
  hints     ExerciseHint[]

  @@index([externalKey])
  @@index([legacyProblemNo])
  @@map("programming_exercises")
}

model ExerciseTestCase {
  id                 String             @id @default(uuid()) @db.Uuid
  exerciseMaterialId String             @map("exercise_material_id") @db.Uuid
  position           Int
  input              String
  expectedOutput     String             @map("expected_output")
  visibility         TestCaseVisibility
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  exercise ProgrammingExercise @relation(fields: [exerciseMaterialId], references: [materialId], onDelete: Cascade)

  @@unique([exerciseMaterialId, position])
  @@map("exercise_test_cases")
}

/// A student's work in progress on one exercise.
///
/// Deliberately separate from any submission or collaboration record: v1 stored
/// drafts in `collaboration_sessions.final_code`, which tangled "what I am
/// typing" together with "who is watching me" and cleared a student's working
/// solution once it passed. One row per student per exercise, kept even after a
/// correct answer.
model ExerciseDraft {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  materialId       String?  @map("material_id") @db.Uuid
  sourceMaterialId String   @map("source_material_id") @db.Uuid
  courseId         String   @map("course_id") @db.Uuid
  code             String
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                  User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  material              Material?                      @relation(fields: [materialId], references: [id], onDelete: SetNull)
  course                Course                         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  collaborationDocument ExerciseCollaborationDocument?

  @@unique([userId, materialId])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("exercise_drafts")
}

/// The CRDT state behind one draft, written only while that draft is being
/// collaborated on.
///
/// One row per draft, created lazily on first live collaboration — an academy
/// that never monitors never grows this table. `ExerciseDraft.code` remains
/// the readable latest snapshot every ordinary learning and submission flow
/// reads; this row exists so a reconnecting client can be told exactly what it
/// missed instead of being handed somebody's whole document.
///
/// The room identity is derived from `draftId` server-side. A client never
/// names a room, so it can never name another student's.
model ExerciseCollaborationDocument {
  draftId         String   @id @map("draft_id") @db.Uuid
  /// A merged Yjs update, not a document history: updates are commutative and
  /// idempotent, so this is safe to overwrite with a merge of itself.
  yjsState        Bytes    @map("yjs_state")
  /// Compare-and-swap guard. Two API instances flushing the same document
  /// merge and retry rather than one silently overwriting the other.
  snapshotVersion BigInt   @default(0) @map("snapshot_version")
  /// Of the plain code derived in the same transaction, so a mismatch between
  /// the CRDT and the draft snapshot is detectable rather than invisible.
  codeHash        String   @map("code_hash")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  draft ExerciseDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@map("exercise_collaboration_documents")
}

/// One graded attempt at an exercise.
model Submission {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  materialId       String?          @map("material_id") @db.Uuid
  sourceMaterialId String           @map("source_material_id") @db.Uuid
  courseId         String           @map("course_id") @db.Uuid
  /// The class learning context selected when this attempt was made. Null is
  /// reserved for submissions written before class attribution existed.
  classId          String?          @map("class_id") @db.Uuid
  gradingRevision  Int              @map("grading_revision")
  language         ExerciseLanguage
  timeLimitMs      Int              @map("time_limit_ms")
  memoryLimitMb    Int              @map("memory_limit_mb")
  code             String
  status           SubmissionStatus @default(QUEUED)
  passedCount      Int              @default(0) @map("passed_count")
  totalCount       Int              @map("total_count")
  /// 0-100. Every problem is worth the same, whatever its case count: a
  /// student must not score differently because an author split one case in
  /// two. Derived from cases passed, never stored per case.
  score            Int              @default(0)
  runtimeMs        Int?             @map("runtime_ms")
  /// Which runtime produced the verdict, so a future upgrade stays auditable.
  engineVersion    String           @map("engine_version")
  failureReason    String?          @map("failure_reason")
  /// Server-owned. v1 accepted a client-reported elapsed time.
  startedAt        DateTime         @default(now()) @map("started_at") @db.Timestamptz(6)
  gradedAt         DateTime?        @map("graded_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  /// The solve session this attempt was made in, and the time it took.
  ///
  /// Deliberately not derived from `createdAt`/`gradedAt`: that interval is
  /// queue and judge latency, which is a fact about the platform rather than
  /// about the student. Null for every row written before solve sessions
  /// existed — old latency is never relabelled as study time.
  solveSessionId  String? @map("solve_session_id") @db.Uuid
  solveElapsedSec Int?    @map("solve_elapsed_sec")

  /// The student-visible labels this row printed when it was written.
  ///
  /// History has to stay readable after ordinary curriculum edits — a renamed
  /// module must not rewrite what a student solved last term. The live
  /// relations still drive filtering, so a hidden course cannot reappear as a
  /// selectable facet; only the printed text is frozen.
  problemTitle    String @map("problem_title")
  courseTitle     String @map("course_title")
  moduleTitle     String @map("module_title")
  lectureTitle    String @map("lecture_title")
  modulePosition  Int    @map("module_position")
  lecturePosition Int    @map("lecture_position")
  problemPosition Int    @map("problem_position")

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  material     Material?               @relation(fields: [materialId], references: [id], onDelete: SetNull)
  course       Course                  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  class        Class?                  @relation(fields: [classId], references: [id], onDelete: SetNull)
  solveSession ExerciseSolveSession?   @relation(fields: [solveSessionId], references: [id], onDelete: SetNull)
  gradingCases SubmissionGradingCase[]
  cases        SubmissionCase[]

  @@index([userId, materialId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  /// Serves the academy-wide answer records page: one student's history,
  /// newest first, with the id tiebreak the default ordering pages on.
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  /// Serves teacher Solution status, which reads from the problem's side: the
  /// user-first indexes above all need a student to start from, and the
  /// By-problem views start from a set of materials.
  @@index([materialId, userId, createdAt(sort: Desc)])
  @@index([classId, userId, createdAt(sort: Desc)])
  @@map("submissions")
}

/// One sitting with one problem, opened by the server.
///
/// The workspace timer and the solve time stored on a submission both read
/// from `startedAt`, so what a student watched while working and what their
/// history reports are the same measurement. The browser never supplies the
/// elapsed value; it only names the session it was working in.
model ExerciseSolveSession {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  materialId String   @map("material_id") @db.Uuid
  /// Null only for sessions created before class attribution existed.
  classId    String?  @map("class_id") @db.Uuid
  startedAt  DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  material    Material     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  class       Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  submissions Submission[]

  @@index([userId, materialId, startedAt(sort: Desc)])
  @@map("exercise_solve_sessions")
}

/// Immutable grading inputs captured before a submission enters the queue.
model SubmissionGradingCase {
  id             String  @id @default(uuid()) @db.Uuid
  submissionId   String  @map("submission_id") @db.Uuid
  position       Int
  input          String
  expectedOutput String  @map("expected_output")
  isSample       Boolean @map("is_sample")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, position])
  @@map("submission_grading_cases")
}

model SubmissionCase {
  id           String      @id @default(uuid()) @db.Uuid
  submissionId String      @map("submission_id") @db.Uuid
  position     Int
  isSample     Boolean     @map("is_sample")
  outcome      CaseOutcome
  runtimeMs    Int?        @map("runtime_ms")
  /// Populated only for SAMPLE cases. A hidden case records an outcome and
  /// nothing else — otherwise a student could reconstruct hidden expectations
  /// by submitting probes.
  actualOutput String?     @map("actual_output")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, position])
  @@map("submission_cases")
}

/// Written in the same transaction as a submission result. Never aggregated on
/// read: v1's teacher progress endpoint scans every submission per request and
/// is already slow.
model StudentExerciseProgress {
  id              String                 @id @default(uuid()) @db.Uuid
  userId          String                 @map("user_id") @db.Uuid
  materialId      String                 @map("material_id") @db.Uuid
  status          ExerciseProgressStatus @default(NOT_STARTED)
  attemptCount    Int                    @default(0) @map("attempt_count")
  bestPassed      Int                    @default(0) @map("best_passed")
  /// Highest ever earned, never reduced by a later worse attempt. A summable
  /// column, so a future leaderboard is one GROUP BY rather than a walk over
  /// every submission.
  bestScore       Int                    @default(0) @map("best_score")
  gradingRevision Int                    @default(1) @map("grading_revision")
  firstSolvedAt   DateTime?              @map("first_solved_at") @db.Timestamptz(6)
  lastAttemptAt   DateTime?              @map("last_attempt_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([userId, status])
  /// "Who in this class has solved this exercise", for teacher analytics.
  @@index([materialId, status, userId])
  @@map("student_exercise_progress")
}

/// One teacher's watch of one student, from entry to exit.
///
/// Access accountability, not a replay. It answers "who could see this student
/// and when", and it deliberately cannot answer more: there is no column for
/// source code, cursors, pointers, feedback text, or grading internals.
///
/// The live membership relations are `SetNull` so removing a member never
/// deletes the record of what they did, while the immutable `*_ref` UUIDs keep
/// the answer readable afterwards — the same principle as `AuditLog.targetId`.
/// Academy and class are `Restrict`: their lifecycle is archive, not delete.
model TeacherMonitoringVisit {
  id                   String                    @id @default(uuid()) @db.Uuid
  academyId            String                    @map("academy_id") @db.Uuid
  classId              String                    @map("class_id") @db.Uuid
  teacherMembershipId  String?                   @map("teacher_membership_id") @db.Uuid
  studentMembershipId  String?                   @map("student_membership_id") @db.Uuid
  teacherMembershipRef String                    @map("teacher_membership_ref") @db.Uuid
  studentMembershipRef String                    @map("student_membership_ref") @db.Uuid
  materialId           String?                   @map("material_id") @db.Uuid
  startedAt            DateTime                  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt              DateTime?                 @map("ended_at") @db.Timestamptz(6)
  endReason            MonitoringVisitEndReason? @map("end_reason")
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  academy           Academy            @relation(fields: [academyId], references: [id], onDelete: Restrict)
  class             Class              @relation(fields: [classId], references: [id], onDelete: Restrict)
  teacherMembership AcademyMembership? @relation("MonitoringVisitTeacher", fields: [teacherMembershipId], references: [id], onDelete: SetNull)
  studentMembership AcademyMembership? @relation("MonitoringVisitStudent", fields: [studentMembershipId], references: [id], onDelete: SetNull)
  material          Material?          @relation(fields: [materialId], references: [id], onDelete: SetNull)
  feedback          TeacherFeedback[]

  /// Answers "who watched this student, most recently first".
  @@index([studentMembershipRef, startedAt(sort: Desc)])
  @@index([teacherMembershipRef, startedAt(sort: Desc)])
  /// Finds the visits still open, which is what revocation has to close.
  @@index([classId, endedAt])
  @@map("teacher_monitoring_visits")
}

/// A durable written message from the assigned teacher to one student.
///
/// Persisted before it is broadcast, so a client never renders a message the
/// database rejected. The unique key makes a retried send store one row rather
/// than two, which is what lets the socket command retry at all.
///
/// The body lives here and nowhere else: it is excluded from audit payloads
/// and operational logs on purpose.
model TeacherFeedback {
  id                   String    @id @default(uuid()) @db.Uuid
  academyId            String    @map("academy_id") @db.Uuid
  classId              String    @map("class_id") @db.Uuid
  teacherMembershipId  String?   @map("teacher_membership_id") @db.Uuid
  studentMembershipId  String?   @map("student_membership_id") @db.Uuid
  teacherMembershipRef String    @map("teacher_membership_ref") @db.Uuid
  studentMembershipRef String    @map("student_membership_ref") @db.Uuid
  materialId           String?   @map("material_id") @db.Uuid
  monitoringVisitId    String?   @map("monitoring_visit_id") @db.Uuid
  /// Client-generated per send. Scoped to the author, so two teachers cannot
  /// collide and one teacher's retry cannot overwrite another's message.
  idempotencyKey       String    @map("idempotency_key") @db.Uuid
  body                 String
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// When the teacher last rewrote this note.
  ///
  /// A teacher gets one note per student per exercise and edits it in place,
  /// so the row outlives its original wording. Equal to `createdAt` until the
  /// first rewrite.
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// When the student opened the thread this message was in.
  ///
  /// Null is unread. One column answers both halves of the question: the
  /// student's badge counts nulls, and the teacher learns whether the sentence
  /// they wrote was actually read. Never set by the author.
  readAt               DateTime? @map("read_at") @db.Timestamptz(6)

  academy           Academy                 @relation(fields: [academyId], references: [id], onDelete: Restrict)
  class             Class                   @relation(fields: [classId], references: [id], onDelete: Restrict)
  teacherMembership AcademyMembership?      @relation("TeacherFeedbackAuthor", fields: [teacherMembershipId], references: [id], onDelete: SetNull)
  studentMembership AcademyMembership?      @relation("TeacherFeedbackRecipient", fields: [studentMembershipId], references: [id], onDelete: SetNull)
  material          Material?               @relation(fields: [materialId], references: [id], onDelete: SetNull)
  monitoringVisit   TeacherMonitoringVisit? @relation(fields: [monitoringVisitId], references: [id], onDelete: SetNull)

  @@unique([teacherMembershipRef, idempotencyKey])
  /// The student's own history, and one exercise's thread inside it.
  @@index([studentMembershipRef, createdAt(sort: Desc)])
  @@index([studentMembershipRef, materialId, createdAt(sort: Desc)], map: "teacher_feedback_student_material_created_at_idx")
  /// The one note this teacher already wrote this student for this exercise.
  @@index([teacherMembershipRef, studentMembershipRef, materialId, createdAt(sort: Desc)], map: "teacher_feedback_author_thread_idx")
  @@map("teacher_feedback")
}

model ExerciseHint {
  id                 String   @id @default(uuid()) @db.Uuid
  exerciseMaterialId String   @map("exercise_material_id") @db.Uuid
  position           Int
  content            String
  triggerExpression  String?  @map("trigger_expression")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  exercise ProgrammingExercise @relation(fields: [exerciseMaterialId], references: [materialId], onDelete: Cascade)

  @@unique([exerciseMaterialId, position])
  @@map("exercise_hints")
}

/// One student's counted active learning time, in one course, on one
/// academy-local day.
///
/// A projection, not an event log. The alternative — keeping every heartbeat —
/// would store a child's minute-by-minute movements to answer a question that
/// only ever needs a daily total, and the overview has no use for the detail
/// that would make it worth the risk.
///
/// This academy/course projection remains the source for academy-wide learning
/// reports. Class ranking reads the separate class-aware projection below.
///
/// Increments are idempotent through `LearningActivityFlush`: a retried flush
/// finds its receipt already present and adds nothing.
model StudentCourseLearningDay {
  academyId       String   @map("academy_id") @db.Uuid
  membershipId    String   @map("membership_id") @db.Uuid
  courseId        String   @map("course_id") @db.Uuid
  /// The academy-local calendar day, not a UTC one. An evening class must not
  /// be split across two dates.
  localDate       DateTime @map("local_date") @db.Date
  activeSeconds   Int      @default(0) @map("active_seconds")
  /// How many separate intervals those seconds came from, so a total can be
  /// read as one long session or twelve short ones.
  activeIntervals Int      @default(0) @map("active_intervals")
  firstActiveAt   DateTime @map("first_active_at") @db.Timestamptz(6)
  lastActiveAt    DateTime @map("last_active_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  academy    Academy           @relation(fields: [academyId], references: [id], onDelete: Cascade)
  membership AcademyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  course     Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([academyId, membershipId, courseId, localDate])
  /// The academy-wide daily momentum series.
  @@index([academyId, localDate])
  /// One student's own time in one course, for the participation scatter.
  @@index([membershipId, courseId, localDate])
  @@map("student_course_learning_days")
}

/// The same accepted active-learning increments projected into the explicit
/// class context selected by the student. It is intentionally separate from
/// `StudentCourseLearningDay`: academy reports keep their established totals,
/// while a class leaderboard never borrows time from another class that happens
/// to use the same course.
model StudentClassCourseLearningDay {
  academyId       String   @map("academy_id") @db.Uuid
  membershipId    String   @map("membership_id") @db.Uuid
  classId         String   @map("class_id") @db.Uuid
  courseId        String   @map("course_id") @db.Uuid
  localDate       DateTime @map("local_date") @db.Date
  activeSeconds   Int      @default(0) @map("active_seconds")
  activeIntervals Int      @default(0) @map("active_intervals")
  firstActiveAt   DateTime @map("first_active_at") @db.Timestamptz(6)
  lastActiveAt    DateTime @map("last_active_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  academy    Academy           @relation(fields: [academyId], references: [id], onDelete: Cascade)
  membership AcademyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  class      Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  course     Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([academyId, membershipId, classId, courseId, localDate])
  @@index([classId, localDate, membershipId])
  @@index([membershipId, classId, localDate])
  @@map("student_class_course_learning_days")
}

/// A receipt for one accepted activity flush.
///
/// The row is the idempotency key. A queued flush carries a UUID generated
/// before the write; the transaction inserts the receipt and increments the
/// daily projection together, so a retry after a timeout collides on the
/// primary key and adds nothing rather than adding the minute twice.
///
/// Receipts are deleted after a week — longer than the queue's retry horizon,
/// short enough that the table stays small.
model LearningActivityFlush {
  id           String   @id @db.Uuid
  academyId    String   @map("academy_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("learning_activity_flushes")
}

/// When one class meets, as a recurring academy-local rule.
///
/// Minutes from local midnight rather than instants, because the rule is
/// "Tuesdays at four" and not "2026-09-01T07:00Z". Stored as an instant it
/// would be wrong the first time an academy changed timezone, and unreadable
/// to the manager who typed it.
///
/// A class with no slots simply never pays attendance points. Nothing else
/// about it changes, which is what lets this arrive without a backfill.
model ClassScheduleSlot {
  id            String    @id @default(uuid()) @db.Uuid
  classId       String    @map("class_id") @db.Uuid
  /// 1 = Monday … 7 = Sunday, ISO-8601, academy-local.
  weekday       Int
  /// Minutes from academy-local midnight. 16:00 is 960.
  startMinute   Int       @map("start_minute")
  /// May exceed 1440 for a class that crosses midnight. It never wraps.
  endMinute     Int       @map("end_minute")
  /// A term change adds a slot and closes the old one. Nothing is deleted, so
  /// last month's attendance stays explicable.
  effectiveFrom DateTime? @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId, weekday])
  @@map("class_schedule_slots")
}

/// One earned point award. Append-only.
///
/// The ledger is the truth and `StudentPointBalance` is a fast answer derived
/// from it — the same relationship `StudentCourseLearningDay` has to the
/// heartbeats that built it. Nothing here is ever updated except a void, and a
/// void is an exclusion rather than a subtraction: `amount` is positive by
/// check constraint and no service writes a negative one.
///
/// Every row is written by the server inside the transaction that recorded the
/// fact it describes. No person can grant one.
model PointAward {
  id           String      @id @default(uuid()) @db.Uuid
  academyId    String      @map("academy_id") @db.Uuid
  membershipId String      @map("membership_id") @db.Uuid
  reason       PointReason
  /// Always > 0. §7.6 of the student points design.
  amount       Int
  /// The idempotency key, and the whole concurrency design.
  ///
  /// A retried judge callback or a replayed activity flush collides here and
  /// writes nothing — there is no read-then-write and no lock. It deliberately
  /// contains no grading revision, no difficulty, no point value, and no
  /// timestamp finer than a day: every one of those would let the same fact
  /// pay twice after an ordinary curriculum edit. §9.3.
  dedupeKey    String      @unique @map("dedupe_key")

  /// What it was for. All nullable — not every reason has every subject.
  materialId String?   @map("material_id") @db.Uuid
  lectureId  String?   @map("lecture_id") @db.Uuid
  moduleId   String?   @map("module_id") @db.Uuid
  courseId   String?   @map("course_id") @db.Uuid
  classId    String?   @map("class_id") @db.Uuid
  localDate  DateTime? @map("local_date") @db.Date

  /// The label this row printed when it was written.
  ///
  /// History has to stay readable after ordinary curriculum edits — the same
  /// reason `Submission.problemTitle` is frozen. A renamed lecture must not
  /// rewrite what a student earned last term.
  subjectLabel String              @map("subject_label")
  /// Frozen difficulty for a solve, so the ledger can print the word it paid
  /// for even after an author reclassifies the problem.
  difficulty   ExerciseDifficulty? @map("difficulty")

  /// Set when the daily cap truncated this award, so the ledger can say why
  /// the number stopped moving instead of paying nothing silently.
  cappedAt DateTime? @map("capped_at") @db.Timestamptz(6)

  /// A platform correction — a misconfigured difficulty, a double-paid tier.
  /// MANAGER-only, audit-logged, and never a deduction: the row is excluded
  /// from every sum and still shown to the student with its reason.
  voidedAt             DateTime? @map("voided_at") @db.Timestamptz(6)
  voidedByMembershipId String?   @map("voided_by_membership_id") @db.Uuid
  voidReason           String?   @map("void_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  academy    Academy           @relation(fields: [academyId], references: [id], onDelete: Cascade)
  membership AcademyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  class      Class?            @relation(fields: [classId], references: [id], onDelete: SetNull)

  /// The period sum behind every leaderboard row.
  @@index([academyId, classId, membershipId, createdAt])
  /// One student's ledger, newest first, with the id tiebreak paging needs.
  @@index([membershipId, createdAt(sort: Desc), id(sort: Desc)])
  /// The daily cap, which is checked before every single award.
  @@index([membershipId, classId, localDate])
  @@map("point_awards")
}

/// One student's running totals. A projection, rebuildable by SUM at any time.
model StudentPointBalance {
  /// Keyed on the membership alone, with the academy denormalized beside it —
  /// the shape `StudentAcademyProfile` already uses. A membership belongs to
  /// exactly one academy, so a composite key would only give the same fact a
  /// second place to drift.
  membershipId String   @id @map("membership_id") @db.Uuid
  academyId    String   @map("academy_id") @db.Uuid
  earnedTotal  Int      @default(0) @map("earned_total")
  spentTotal   Int      @default(0) @map("spent_total")
  /// For the deferred 스탬프판. Written by nothing yet; the column exists so
  /// the board does not need a migration to arrive.
  stampCount   Int      @default(0) @map("stamp_count")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  membership AcademyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([academyId])
  @@map("student_point_balances")
}

/// One academy's point economy. Numbers, not code.
///
/// A missing row means the defaults in `@cove/shared`, so enabling points
/// never requires a manager to fill a form first.
model AcademyPointPolicy {
  academyId String @id @map("academy_id") @db.Uuid

  solveEasy   Int @default(3) @map("solve_easy")
  solveMedium Int @default(5) @map("solve_medium")
  solveHard   Int @default(10) @map("solve_hard")

  lectureCompleted Int @default(15) @map("lecture_completed")
  moduleCompleted  Int @default(40) @map("module_completed")
  courseCompleted  Int @default(150) @map("course_completed")

  attendance             Int @default(5) @map("attendance")
  attendanceLate         Int @default(2) @map("attendance_late")
  attendanceMinMinutes   Int @default(10) @map("attendance_min_minutes")
  attendanceGraceMinutes Int @default(15) @map("attendance_grace_minutes")

  learningTimeTier1Minutes Int @default(30) @map("learning_time_tier1_minutes")
  learningTimeTier1Points  Int @default(3) @map("learning_time_tier1_points")
  learningTimeTier2Minutes Int @default(60) @map("learning_time_tier2_minutes")
  learningTimeTier2Points  Int @default(5) @map("learning_time_tier2_points")
  learningTimeTier3Minutes Int @default(120) @map("learning_time_tier3_minutes")
  learningTimeTier3Points  Int @default(7) @map("learning_time_tier3_points")

  /// The most one student may earn in one academy-local day. Without it the
  /// board measures endurance rather than learning.
  studentDailyCap Int @default(100) @map("student_daily_cap")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  @@map("academy_point_policies")
}
