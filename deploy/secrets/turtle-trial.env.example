# Independent secret; match API TURTLE_TRIAL_SERVICE_SECRET.
GUI_SERVICE_SECRET=replace_with_independent_32_or_more_random_characters
GUI_RUNTIME_IMAGE=ghcr.io/dlabmapo-web/cove-gui-runtime@sha256:replace_with_approved_digest
GUI_ALLOWED_ORIGINS=https://cs.coveedu.com
# Development defaults to one. Set production only from measured resources.
GUI_SESSION_CAPACITY=1
GUI_TRIAL_ONLY=true
# Leave warm mode off until the combined host envelope and benchmark gates pass.
GUI_WARM_STANDBY=0
# Optional private /metrics credential. Must differ from GUI_SERVICE_SECRET.
# GUI_METRICS_SECRET=replace_with_an_independent_random_32_or_more_character_secret
