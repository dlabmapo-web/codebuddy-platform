generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  USER
  ADMIN
}

enum UserStatus {
  PENDING_PROFILE
  ACTIVE
  SUSPENDED
  DELETED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum AcademyStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum AcademyRole {
  STUDENT
  TEACHER
  TEAM_LEAD
  MANAGER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  LEFT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum OAuthOnboardingIntentStatus {
  PENDING
  CONSUMED
  EXPIRED
}

enum ClassStatus {
  ACTIVE
  ARCHIVED
}

/// Per-academy rollout switches. An enum rather than a free string so a typo
/// cannot read as "off" for every academy at once.
enum AcademyFeature {
  TEACHER_LIVE_MONITORING
}

/// Why one teacher's watch of one student ended. Recorded on the visit and
/// sent to both clients, so a revoked teacher sees a reason instead of a
/// silent disconnection.
enum MonitoringVisitEndReason {
  TEACHER_LEFT
  WATCH_REPLACED
  STUDENT_LEFT
  ASSIGNMENT_CHANGED
  CLASS_ARCHIVED
  ENROLLMENT_REMOVED
  MEMBERSHIP_INACTIVE
  ROLE_CHANGED
  MATERIAL_UNAVAILABLE
  CONNECTION_EXPIRED
  FEATURE_DISABLED
}

enum MaterialType {
  PROGRAMMING_EXERCISE
}

enum ExerciseDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ExerciseLanguage {
  PYTHON
}

enum TestCaseVisibility {
  SAMPLE
  HIDDEN
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  /// Judge fault. Never counted against the student's attempts.
  ERRORED
  CANCELLED
}

enum CaseOutcome {
  PASSED
  WRONG_OUTPUT
  RUNTIME_ERROR
  TIME_LIMIT
  MEMORY_LIMIT
  /// Not run, because an earlier case already failed.
  SKIPPED
}

/// What a stored image is *for*. The purpose decides which relation may own
/// the asset and which authorization rule delivers it, so it is an enum rather
/// than a free string: a typo must not silently create a fourth category that
/// no read rule covers.
enum MediaAssetPurpose {
  USER_AVATAR
  ACADEMY_MEMBER_AVATAR
}

/// How a guardian relates to a student. `OTHER` exists so the alternative is
/// not a free-text column that quietly collects names and phone numbers.
enum GuardianRelationship {
  MOTHER
  FATHER
  GRANDPARENT
  SIBLING
  LEGAL_GUARDIAN
  OTHER
}

enum ExerciseProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  SOLVED
}

model User {
  id                 String       @id @default(uuid()) @db.Uuid
  authUserId         String?      @unique @map("auth_user_id") @db.Uuid
  email              String?      @unique
  /// Sign-in name. Lowercase, globally unique, and never reused as a rename
  /// handle. Null for accounts that arrived through OAuth or predate it.
  username           String?      @unique
  displayName        String?      @map("display_name")
  /// The external OAuth photo, kept as a fallback only. Once a Cove image
  /// exists, `avatarAssetId` is authoritative and this is never consulted.
  /// A signed delivery URL is never written here — it would outlive the
  /// authorization that produced it.
  avatarUrl          String?      @map("avatar_url")
  /// The Cove-owned, privately stored profile image.
  avatarAssetId      String?      @map("avatar_asset_id") @db.Uuid
  /// Not a sign-in credential. Stored in canonical international form; the
  /// client formats it for the reader's locale.
  contactPhone       String?      @map("contact_phone")
  /// The locale the account reads Cove in, independent of any academy.
  preferredLocale    String       @default("ko") @map("preferred_locale")
  /// An IANA zone name. Null means "follow the browser", which is the right
  /// default for a student who has never thought about it.
  timezone           String?
  platformRole       PlatformRole @default(USER) @map("platform_role")
  status             UserStatus   @default(PENDING_PROFILE)
  legacyUserId       String?      @unique @map("legacy_user_id")
  legacyUsername     String?      @unique @map("legacy_username")
  legacyPasswordHash String?      @map("legacy_password_hash")
  migratedAt         DateTime?    @map("migrated_at") @db.Timestamptz(6)
  lastSignInAt       DateTime?    @map("last_sign_in_at") @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships           AcademyMembership[]
  invitationsCreated    AcademyInvitation[]       @relation("InvitationCreator")
  invitationsAccepted   AcademyInvitation[]       @relation("InvitationAcceptor")
  joinRequests          AcademyJoinRequest[]      @relation("JoinRequester")
  joinRequestsReviewed  AcademyJoinRequest[]      @relation("JoinReviewer")
  membershipInvitations AcademyMembership[]       @relation("MembershipInviter")
  membershipApprovals   AcademyMembership[]       @relation("MembershipApprover")
  auditLogs             AuditLog[]                @relation("AuditActor")
  coursesCreated        Course[]                  @relation("CourseCreator")
  classesCreated        Class[]                   @relation("ClassCreator")
  classCoursesAssigned  ClassCourse[]             @relation("ClassCourseAssigner")
  classEnrollmentsMade  ClassEnrollment[]         @relation("ClassEnroller")
  exerciseDrafts        ExerciseDraft[]
  submissions           Submission[]
  exerciseProgress      StudentExerciseProgress[]
  solveSessions         ExerciseSolveSession[]
  avatarAsset           MediaAsset?               @relation("UserAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  mediaUploaded         MediaAsset[]              @relation("MediaUploader")

  @@index([status])
  @@map("users")
}

/// One stored object in the private profile-image bucket.
///
/// The row is metadata and ownership; the bytes live in Supabase Storage and
/// the delivery URL is minted per request. `uploaderUserId` records who
/// performed the upload and decides nothing about who may view it — a manager
/// who uploads a student's photo does not thereby own it, and the student does
/// not lose it when that manager leaves.
model MediaAsset {
  id             String            @id @default(uuid()) @db.Uuid
  bucket         String
  /// Immutable, and scoped by business identity. Replacing a photo writes a
  /// new object and repoints the relation; it never overwrites in place, so a
  /// failed upload cannot destroy the picture already on the profile.
  objectKey      String            @unique @map("object_key")
  purpose        MediaAssetPurpose
  uploaderUserId String            @map("uploader_user_id") @db.Uuid
  contentType    String            @map("content_type")
  sizeBytes      Int               @map("size_bytes")
  width          Int
  height         Int
  checksumSha256 String            @map("checksum_sha256")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Set when a newer asset replaced this one. Cleanup deletes the object
  /// after the grace period, so a transient failure stays recoverable.
  supersededAt   DateTime?         @map("superseded_at") @db.Timestamptz(6)
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz(6)

  uploader      User                   @relation("MediaUploader", fields: [uploaderUserId], references: [id], onDelete: Restrict)
  userAvatars   User[]                 @relation("UserAvatar")
  memberAvatars AcademyMemberProfile[] @relation("AcademyMemberAvatar")

  /// The cleanup sweep: superseded and orphaned objects, oldest first.
  @@index([supersededAt, createdAt])
  @@index([purpose, createdAt])
  @@map("media_assets")
}

/// The academy-scoped presentation of one member, whatever their role.
///
/// Keyed by membership rather than user, which is the boundary the whole
/// feature rests on: one account can be a student in Mapo and a teacher in
/// Gangnam, and neither academy's manager may edit the other's view of them.
/// Every field here is an *override* — a null reveals the global value rather
/// than blanking it.
model AcademyMemberProfile {
  membershipId       String   @id @map("membership_id") @db.Uuid
  academyDisplayName String?  @map("academy_display_name")
  avatarAssetId      String?  @map("avatar_asset_id") @db.Uuid
  contactPhone       String?  @map("contact_phone")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  membership  AcademyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  avatarAsset MediaAsset?       @relation("AcademyMemberAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)

  @@map("academy_member_profiles")
}

/// A student's academy record.
///
/// Created lazily on first edit, and never deleted by a role change: a member
/// promoted to teacher and later corrected back must not have lost their
/// guardian details in between. Endpoints return only the shape matching the
/// membership's current role, so a stale row is invisible until it is relevant
/// again.
model StudentAcademyProfile {
  membershipId          String                @id @map("membership_id") @db.Uuid
  /// Denormalized from the membership so academy-local uniqueness is a
  /// database constraint rather than a service that remembers to check.
  academyId             String                @map("academy_id") @db.Uuid
  dateOfBirth           DateTime?             @map("date_of_birth") @db.Date
  schoolName            String?               @map("school_name")
  schoolGrade           String?               @map("school_grade")
  guardianName          String?               @map("guardian_name")
  guardianRelationship  GuardianRelationship? @map("guardian_relationship")
  guardianPhone         String?               @map("guardian_phone")
  emergencyContactName  String?               @map("emergency_contact_name")
  emergencyContactPhone String?               @map("emergency_contact_phone")
  /// The student's own words. A manager reads these and does not rewrite them.
  codingInterests       String[]              @map("coding_interests")
  learningGoal          String?               @map("learning_goal")
  /// Manager-owned, and unique only inside one academy.
  studentNumber         String?               @map("student_number")
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  membership AcademyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  /// Postgres treats NULLs as distinct, so every student without a number
  /// coexists and only two identical numbers collide.
  @@unique([academyId, studentNumber])
  @@map("student_academy_profiles")
}

/// One shape for `TEACHER`, `TEAM_LEAD`, and `MANAGER`.
///
/// Those roles differ in authority, not in biography. Three near-identical
/// models would only give a field three places to drift, and the profile never
/// implies a permission — the authorization map still decides that.
model StaffAcademyProfile {
  membershipId      String   @id @map("membership_id") @db.Uuid
  /// Denormalized for the same reason as the student profile's copy.
  academyId         String   @map("academy_id") @db.Uuid
  bio               String?
  specialties       String[]
  teachingLanguages String[] @map("teaching_languages")
  /// Manager-owned: what the academy says this person is responsible for.
  academyTitle      String?  @map("academy_title")
  employeeNumber    String?  @map("employee_number")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  membership AcademyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([academyId, employeeNumber])
  @@map("staff_academy_profiles")
}

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  academies Academy[]

  @@map("organizations")
}

model Academy {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String
  slug           String
  status         AcademyStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization           Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships            AcademyMembership[]
  invitations            AcademyInvitation[]
  joinRequests           AcademyJoinRequest[]
  oauthOnboardingIntents OAuthOnboardingIntent[]
  auditLogs              AuditLog[]
  courses                Course[]
  classes                Class[]
  featureFlags           AcademyFeatureFlag[]
  monitoringVisits       TeacherMonitoringVisit[]
  teacherFeedback        TeacherFeedback[]
  learningDays           StudentCourseLearningDay[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@map("academies")
}

/// One rollout switch for one academy.
///
/// A missing row means off: enabling a feature is always a deliberate write,
/// so a new academy never starts inside a staged rollout.
model AcademyFeatureFlag {
  academyId String         @map("academy_id") @db.Uuid
  feature   AcademyFeature
  isEnabled Boolean        @default(false) @map("is_enabled")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  @@id([academyId, feature])
  @@map("academy_feature_flags")
}

model OAuthOnboardingIntent {
  id                   String                      @id @default(uuid()) @db.Uuid
  tokenHash            String                      @unique @map("token_hash")
  academyId            String                      @map("academy_id") @db.Uuid
  provider             String
  status               OAuthOnboardingIntentStatus @default(PENDING)
  expiresAt            DateTime                    @map("expires_at") @db.Timestamptz(6)
  consumedAt           DateTime?                   @map("consumed_at") @db.Timestamptz(6)
  consumedByAuthUserId String?                     @map("consumed_by_auth_user_id") @db.Uuid
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([academyId, createdAt])
  @@map("oauth_onboarding_intents")
}

model AcademyMembership {
  id               String           @id @default(uuid()) @db.Uuid
  academyId        String           @map("academy_id") @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  role             AcademyRole
  status           MembershipStatus @default(INVITED)
  invitedByUserId  String?          @map("invited_by_user_id") @db.Uuid
  approvedByUserId String?          @map("approved_by_user_id") @db.Uuid
  joinedAt         DateTime?        @map("joined_at") @db.Timestamptz(6)
  suspendedAt      DateTime?        @map("suspended_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  academy          Academy           @relation(fields: [academyId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy        User?             @relation("MembershipInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  approvedBy       User?             @relation("MembershipApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  classEnrollments ClassEnrollment[]
  assignedClasses  Class[]           @relation("ClassTeacher")

  monitoringVisitsAsTeacher TeacherMonitoringVisit[]   @relation("MonitoringVisitTeacher")
  monitoringVisitsAsStudent TeacherMonitoringVisit[]   @relation("MonitoringVisitStudent")
  feedbackAuthored          TeacherFeedback[]          @relation("TeacherFeedbackAuthor")
  feedbackReceived          TeacherFeedback[]          @relation("TeacherFeedbackRecipient")
  learningDays              StudentCourseLearningDay[]
  memberProfile             AcademyMemberProfile?
  studentProfile            StudentAcademyProfile?
  staffProfile              StaffAcademyProfile?

  @@unique([academyId, userId])
  @@index([userId, status])
  @@index([academyId, role, status])
  @@map("academy_memberships")
}

model AcademyInvitation {
  id               String           @id @default(uuid()) @db.Uuid
  academyId        String           @map("academy_id") @db.Uuid
  email            String
  role             AcademyRole
  tokenHash        String           @unique @map("token_hash")
  status           InvitationStatus @default(PENDING)
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(6)
  invitedByUserId  String           @map("invited_by_user_id") @db.Uuid
  acceptedByUserId String?          @map("accepted_by_user_id") @db.Uuid
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz(6)
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  academy    Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  invitedBy  User    @relation("InvitationCreator", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy User?   @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([academyId, email, status])
  @@index([expiresAt, status])
  @@map("academy_invitations")
}

model AcademyJoinRequest {
  id               String            @id @default(uuid()) @db.Uuid
  academyId        String            @map("academy_id") @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  message          String?
  status           JoinRequestStatus @default(PENDING)
  approvedRole     AcademyRole?      @map("approved_role")
  reviewedByUserId String?           @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  reviewReason     String?           @map("review_reason")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  academy    Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  user       User    @relation("JoinRequester", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("JoinReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([academyId, status, createdAt])
  @@index([userId, status])
  @@map("academy_join_requests")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  academyId   String?  @map("academy_id") @db.Uuid
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  before      Json?
  after       Json?
  requestId   String?  @map("request_id")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor   User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  academy Academy? @relation(fields: [academyId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([academyId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model Course {
  id              String   @id @default(uuid()) @db.Uuid
  academyId       String   @map("academy_id") @db.Uuid
  title           String
  description     String   @default("")
  isVisible       Boolean  @default(false) @map("is_visible")
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  academy          Academy                    @relation(fields: [academyId], references: [id], onDelete: Restrict)
  createdBy        User                       @relation("CourseCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  modules          CourseModule[]
  exerciseDrafts   ExerciseDraft[]
  submissions      Submission[]
  classAssignments ClassCourse[]
  learningDays     StudentCourseLearningDay[]

  @@index([academyId, isVisible, updatedAt])
  @@map("courses")
}

/// The delivery boundary between reusable curriculum and learners: a class
/// learns many courses, a course is taught to many classes, and a student may
/// sit in several classes of the same academy.
///
/// Names are intentionally not unique — an academy reuses "Level 1" every
/// term — so the UUID is the identity and the UI shows status for context.
model Class {
  id                  String      @id @default(uuid()) @db.Uuid
  academyId           String      @map("academy_id") @db.Uuid
  name                String
  description         String      @default("")
  status              ClassStatus @default(ACTIVE)
  createdByUserId     String      @map("created_by_user_id") @db.Uuid
  /// The one teacher responsible for this class, or null while unassigned.
  /// Deliberately not unique: one teacher runs many classes. It stores the
  /// membership rather than the user so academy scope and academy role are
  /// both explicit — but the key alone cannot prove same-academy, so every
  /// read and write still checks the academy in the query.
  teacherMembershipId String?     @map("teacher_membership_id") @db.Uuid
  archivedAt          DateTime?   @map("archived_at") @db.Timestamptz(6)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Touched by course and roster changes too, so the management list reports
  /// the most recent change of any kind rather than only the last rename.
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  academy           Academy                  @relation(fields: [academyId], references: [id], onDelete: Restrict)
  createdBy         User                     @relation("ClassCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  /// SetNull, not Cascade: deleting a membership must leave the class intact
  /// and merely unassigned. Suspension and role changes delete nothing, so a
  /// stale assignment stays visible to managers as unavailable.
  assignedTeacher   AcademyMembership?       @relation("ClassTeacher", fields: [teacherMembershipId], references: [id], onDelete: SetNull)
  courseAssignments ClassCourse[]
  enrollments       ClassEnrollment[]
  monitoringVisits  TeacherMonitoringVisit[]
  teacherFeedback   TeacherFeedback[]

  @@index([academyId, status, updatedAt(sort: Desc)])
  @@index([academyId, name])
  /// Answers "which active classes is this teacher responsible for", the
  /// query the later monitoring design starts from.
  @@index([teacherMembershipId, status])
  @@map("classes")
}

/// One course taught to one class. Removing the row revokes access and never
/// touches drafts, submissions, or progress.
model ClassCourse {
  classId          String   @map("class_id") @db.Uuid
  courseId         String   @map("course_id") @db.Uuid
  assignedByUserId String   @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  class      Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignedBy User   @relation("ClassCourseAssigner", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@id([classId, courseId])
  @@index([courseId, classId])
  @@map("class_courses")
}

/// One student's seat in one class.
///
/// References the academy membership rather than the user: it makes academy
/// scope explicit and lets one person hold different roles in two academies.
/// A suspended or promoted membership stops granting access even while the
/// row remains, so a Manager can still see and clear a stale seat.
model ClassEnrollment {
  classId            String    @map("class_id") @db.Uuid
  membershipId       String    @map("membership_id") @db.Uuid
  enrolledByUserId   String    @map("enrolled_by_user_id") @db.Uuid
  enrolledAt         DateTime  @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  /// Contextual history for an offline roster label, throttled to at most one
  /// write a minute per student. Never a presence truth source: a timestamp
  /// cannot tell a closed laptop from a tab that is still open.
  lastLearningSeenAt DateTime? @map("last_learning_seen_at") @db.Timestamptz(6)

  class      Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  membership AcademyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  enrolledBy User              @relation("ClassEnroller", fields: [enrolledByUserId], references: [id], onDelete: Restrict)

  @@id([classId, membershipId])
  @@index([membershipId, classId])
  @@map("class_enrollments")
}

model CourseModule {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @map("course_id") @db.Uuid
  title       String
  description String   @default("")
  position    Int
  /// Hidden modules stay in the curriculum but disappear for students.
  isVisible   Boolean  @default(false) @map("is_visible")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lectures Lecture[]

  @@unique([courseId, position])
  @@index([courseId])
  @@map("course_modules")
}

model Lecture {
  id             String   @id @default(uuid()) @db.Uuid
  courseModuleId String   @map("course_module_id") @db.Uuid
  title          String
  description    String   @default("")
  position       Int
  /// Hidden lectures stay in the curriculum but disappear for students.
  isVisible      Boolean  @default(false) @map("is_visible")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  courseModule CourseModule @relation(fields: [courseModuleId], references: [id], onDelete: Cascade)
  materials    Material[]

  @@unique([courseModuleId, position])
  @@index([courseModuleId])
  @@map("lectures")
}

model Material {
  id         String       @id @default(uuid()) @db.Uuid
  lectureId  String       @map("lecture_id") @db.Uuid
  type       MaterialType
  title      String
  position   Int
  isRequired Boolean      @default(true) @map("is_required")
  /// Hides a single material from students while preserving its work history.
  isVisible  Boolean      @default(false) @map("is_visible")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  lecture             Lecture                   @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  programmingExercise ProgrammingExercise?
  drafts              ExerciseDraft[]
  submissions         Submission[]
  progress            StudentExerciseProgress[]
  monitoringVisits    TeacherMonitoringVisit[]
  teacherFeedback     TeacherFeedback[]
  solveSessions       ExerciseSolveSession[]

  @@unique([lectureId, position])
  @@index([lectureId])
  @@map("materials")
}

model ProgrammingExercise {
  materialId        String             @id @map("material_id") @db.Uuid
  externalKey       String             @map("external_key")
  legacyProblemNo   Int?               @map("legacy_problem_no")
  difficulty        ExerciseDifficulty
  description       String             @default("")
  inputFormat       String             @default("") @map("input_format")
  outputFormat      String             @default("") @map("output_format")
  constraints       String             @default("")
  starterCode       String             @default("") @map("starter_code")
  language          ExerciseLanguage   @default(PYTHON)
  timeLimitMs       Int                @default(3000) @map("time_limit_ms")
  memoryLimitMb     Int                @default(256) @map("memory_limit_mb")
  aiFeedbackEnabled Boolean            @default(false) @map("ai_feedback_enabled")
  gradingRevision   Int                @default(1) @map("grading_revision")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  material  Material           @relation(fields: [materialId], references: [id], onDelete: Cascade)
  testCases ExerciseTestCase[]
  hints     ExerciseHint[]

  @@index([externalKey])
  @@index([legacyProblemNo])
  @@map("programming_exercises")
}

model ExerciseTestCase {
  id                 String             @id @default(uuid()) @db.Uuid
  exerciseMaterialId String             @map("exercise_material_id") @db.Uuid
  position           Int
  input              String
  expectedOutput     String             @map("expected_output")
  visibility         TestCaseVisibility
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  exercise ProgrammingExercise @relation(fields: [exerciseMaterialId], references: [materialId], onDelete: Cascade)

  @@unique([exerciseMaterialId, position])
  @@map("exercise_test_cases")
}

/// A student's work in progress on one exercise.
///
/// Deliberately separate from any submission or collaboration record: v1 stored
/// drafts in `collaboration_sessions.final_code`, which tangled "what I am
/// typing" together with "who is watching me" and cleared a student's working
/// solution once it passed. One row per student per exercise, kept even after a
/// correct answer.
model ExerciseDraft {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  materialId       String?  @map("material_id") @db.Uuid
  sourceMaterialId String   @map("source_material_id") @db.Uuid
  courseId         String   @map("course_id") @db.Uuid
  code             String
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                  User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  material              Material?                      @relation(fields: [materialId], references: [id], onDelete: SetNull)
  course                Course                         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  collaborationDocument ExerciseCollaborationDocument?

  @@unique([userId, materialId])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("exercise_drafts")
}

/// The CRDT state behind one draft, written only while that draft is being
/// collaborated on.
///
/// One row per draft, created lazily on first live collaboration — an academy
/// that never monitors never grows this table. `ExerciseDraft.code` remains
/// the readable latest snapshot every ordinary learning and submission flow
/// reads; this row exists so a reconnecting client can be told exactly what it
/// missed instead of being handed somebody's whole document.
///
/// The room identity is derived from `draftId` server-side. A client never
/// names a room, so it can never name another student's.
model ExerciseCollaborationDocument {
  draftId         String   @id @map("draft_id") @db.Uuid
  /// A merged Yjs update, not a document history: updates are commutative and
  /// idempotent, so this is safe to overwrite with a merge of itself.
  yjsState        Bytes    @map("yjs_state")
  /// Compare-and-swap guard. Two API instances flushing the same document
  /// merge and retry rather than one silently overwriting the other.
  snapshotVersion BigInt   @default(0) @map("snapshot_version")
  /// Of the plain code derived in the same transaction, so a mismatch between
  /// the CRDT and the draft snapshot is detectable rather than invisible.
  codeHash        String   @map("code_hash")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  draft ExerciseDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@map("exercise_collaboration_documents")
}

/// One graded attempt at an exercise.
model Submission {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  materialId       String?          @map("material_id") @db.Uuid
  sourceMaterialId String           @map("source_material_id") @db.Uuid
  courseId         String           @map("course_id") @db.Uuid
  gradingRevision  Int              @map("grading_revision")
  language         ExerciseLanguage
  timeLimitMs      Int              @map("time_limit_ms")
  memoryLimitMb    Int              @map("memory_limit_mb")
  code             String
  status           SubmissionStatus @default(QUEUED)
  passedCount      Int              @default(0) @map("passed_count")
  totalCount       Int              @map("total_count")
  /// 0-100. Every problem is worth the same, whatever its case count: a
  /// student must not score differently because an author split one case in
  /// two. Derived from cases passed, never stored per case.
  score            Int              @default(0)
  runtimeMs        Int?             @map("runtime_ms")
  /// Which runtime produced the verdict, so a future upgrade stays auditable.
  engineVersion    String           @map("engine_version")
  failureReason    String?          @map("failure_reason")
  /// Server-owned. v1 accepted a client-reported elapsed time.
  startedAt        DateTime         @default(now()) @map("started_at") @db.Timestamptz(6)
  gradedAt         DateTime?        @map("graded_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  /// The solve session this attempt was made in, and the time it took.
  ///
  /// Deliberately not derived from `createdAt`/`gradedAt`: that interval is
  /// queue and judge latency, which is a fact about the platform rather than
  /// about the student. Null for every row written before solve sessions
  /// existed — old latency is never relabelled as study time.
  solveSessionId  String? @map("solve_session_id") @db.Uuid
  solveElapsedSec Int?    @map("solve_elapsed_sec")

  /// The student-visible labels this row printed when it was written.
  ///
  /// History has to stay readable after ordinary curriculum edits — a renamed
  /// module must not rewrite what a student solved last term. The live
  /// relations still drive filtering, so a hidden course cannot reappear as a
  /// selectable facet; only the printed text is frozen.
  problemTitle    String @map("problem_title")
  courseTitle     String @map("course_title")
  moduleTitle     String @map("module_title")
  lectureTitle    String @map("lecture_title")
  modulePosition  Int    @map("module_position")
  lecturePosition Int    @map("lecture_position")
  problemPosition Int    @map("problem_position")

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  material     Material?               @relation(fields: [materialId], references: [id], onDelete: SetNull)
  course       Course                  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  solveSession ExerciseSolveSession?   @relation(fields: [solveSessionId], references: [id], onDelete: SetNull)
  gradingCases SubmissionGradingCase[]
  cases        SubmissionCase[]

  @@index([userId, materialId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  /// Serves the academy-wide answer records page: one student's history,
  /// newest first, with the id tiebreak the default ordering pages on.
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  /// Serves teacher Solution status, which reads from the problem's side: the
  /// user-first indexes above all need a student to start from, and the
  /// By-problem views start from a set of materials.
  @@index([materialId, userId, createdAt(sort: Desc)])
  @@map("submissions")
}

/// One sitting with one problem, opened by the server.
///
/// The workspace timer and the solve time stored on a submission both read
/// from `startedAt`, so what a student watched while working and what their
/// history reports are the same measurement. The browser never supplies the
/// elapsed value; it only names the session it was working in.
model ExerciseSolveSession {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  materialId String   @map("material_id") @db.Uuid
  startedAt  DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  material    Material     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([userId, materialId, startedAt(sort: Desc)])
  @@map("exercise_solve_sessions")
}

/// Immutable grading inputs captured before a submission enters the queue.
model SubmissionGradingCase {
  id             String  @id @default(uuid()) @db.Uuid
  submissionId   String  @map("submission_id") @db.Uuid
  position       Int
  input          String
  expectedOutput String  @map("expected_output")
  isSample       Boolean @map("is_sample")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, position])
  @@map("submission_grading_cases")
}

model SubmissionCase {
  id           String      @id @default(uuid()) @db.Uuid
  submissionId String      @map("submission_id") @db.Uuid
  position     Int
  isSample     Boolean     @map("is_sample")
  outcome      CaseOutcome
  runtimeMs    Int?        @map("runtime_ms")
  /// Populated only for SAMPLE cases. A hidden case records an outcome and
  /// nothing else — otherwise a student could reconstruct hidden expectations
  /// by submitting probes.
  actualOutput String?     @map("actual_output")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, position])
  @@map("submission_cases")
}

/// Written in the same transaction as a submission result. Never aggregated on
/// read: v1's teacher progress endpoint scans every submission per request and
/// is already slow.
model StudentExerciseProgress {
  id              String                 @id @default(uuid()) @db.Uuid
  userId          String                 @map("user_id") @db.Uuid
  materialId      String                 @map("material_id") @db.Uuid
  status          ExerciseProgressStatus @default(NOT_STARTED)
  attemptCount    Int                    @default(0) @map("attempt_count")
  bestPassed      Int                    @default(0) @map("best_passed")
  /// Highest ever earned, never reduced by a later worse attempt. A summable
  /// column, so a future leaderboard is one GROUP BY rather than a walk over
  /// every submission.
  bestScore       Int                    @default(0) @map("best_score")
  gradingRevision Int                    @default(1) @map("grading_revision")
  firstSolvedAt   DateTime?              @map("first_solved_at") @db.Timestamptz(6)
  lastAttemptAt   DateTime?              @map("last_attempt_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([userId, status])
  /// "Who in this class has solved this exercise", for teacher analytics.
  @@index([materialId, status, userId])
  @@map("student_exercise_progress")
}

/// One teacher's watch of one student, from entry to exit.
///
/// Access accountability, not a replay. It answers "who could see this student
/// and when", and it deliberately cannot answer more: there is no column for
/// source code, cursors, pointers, feedback text, or grading internals.
///
/// The live membership relations are `SetNull` so removing a member never
/// deletes the record of what they did, while the immutable `*_ref` UUIDs keep
/// the answer readable afterwards — the same principle as `AuditLog.targetId`.
/// Academy and class are `Restrict`: their lifecycle is archive, not delete.
model TeacherMonitoringVisit {
  id                   String                    @id @default(uuid()) @db.Uuid
  academyId            String                    @map("academy_id") @db.Uuid
  classId              String                    @map("class_id") @db.Uuid
  teacherMembershipId  String?                   @map("teacher_membership_id") @db.Uuid
  studentMembershipId  String?                   @map("student_membership_id") @db.Uuid
  teacherMembershipRef String                    @map("teacher_membership_ref") @db.Uuid
  studentMembershipRef String                    @map("student_membership_ref") @db.Uuid
  materialId           String?                   @map("material_id") @db.Uuid
  startedAt            DateTime                  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt              DateTime?                 @map("ended_at") @db.Timestamptz(6)
  endReason            MonitoringVisitEndReason? @map("end_reason")
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  academy           Academy            @relation(fields: [academyId], references: [id], onDelete: Restrict)
  class             Class              @relation(fields: [classId], references: [id], onDelete: Restrict)
  teacherMembership AcademyMembership? @relation("MonitoringVisitTeacher", fields: [teacherMembershipId], references: [id], onDelete: SetNull)
  studentMembership AcademyMembership? @relation("MonitoringVisitStudent", fields: [studentMembershipId], references: [id], onDelete: SetNull)
  material          Material?          @relation(fields: [materialId], references: [id], onDelete: SetNull)
  feedback          TeacherFeedback[]

  /// Answers "who watched this student, most recently first".
  @@index([studentMembershipRef, startedAt(sort: Desc)])
  @@index([teacherMembershipRef, startedAt(sort: Desc)])
  /// Finds the visits still open, which is what revocation has to close.
  @@index([classId, endedAt])
  @@map("teacher_monitoring_visits")
}

/// A durable written message from the assigned teacher to one student.
///
/// Persisted before it is broadcast, so a client never renders a message the
/// database rejected. The unique key makes a retried send store one row rather
/// than two, which is what lets the socket command retry at all.
///
/// The body lives here and nowhere else: it is excluded from audit payloads
/// and operational logs on purpose.
model TeacherFeedback {
  id                   String    @id @default(uuid()) @db.Uuid
  academyId            String    @map("academy_id") @db.Uuid
  classId              String    @map("class_id") @db.Uuid
  teacherMembershipId  String?   @map("teacher_membership_id") @db.Uuid
  studentMembershipId  String?   @map("student_membership_id") @db.Uuid
  teacherMembershipRef String    @map("teacher_membership_ref") @db.Uuid
  studentMembershipRef String    @map("student_membership_ref") @db.Uuid
  materialId           String?   @map("material_id") @db.Uuid
  monitoringVisitId    String?   @map("monitoring_visit_id") @db.Uuid
  /// Client-generated per send. Scoped to the author, so two teachers cannot
  /// collide and one teacher's retry cannot overwrite another's message.
  idempotencyKey       String    @map("idempotency_key") @db.Uuid
  body                 String
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// When the teacher last rewrote this note.
  ///
  /// A teacher gets one note per student per exercise and edits it in place,
  /// so the row outlives its original wording. Equal to `createdAt` until the
  /// first rewrite.
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// When the student opened the thread this message was in.
  ///
  /// Null is unread. One column answers both halves of the question: the
  /// student's badge counts nulls, and the teacher learns whether the sentence
  /// they wrote was actually read. Never set by the author.
  readAt               DateTime? @map("read_at") @db.Timestamptz(6)

  academy           Academy                 @relation(fields: [academyId], references: [id], onDelete: Restrict)
  class             Class                   @relation(fields: [classId], references: [id], onDelete: Restrict)
  teacherMembership AcademyMembership?      @relation("TeacherFeedbackAuthor", fields: [teacherMembershipId], references: [id], onDelete: SetNull)
  studentMembership AcademyMembership?      @relation("TeacherFeedbackRecipient", fields: [studentMembershipId], references: [id], onDelete: SetNull)
  material          Material?               @relation(fields: [materialId], references: [id], onDelete: SetNull)
  monitoringVisit   TeacherMonitoringVisit? @relation(fields: [monitoringVisitId], references: [id], onDelete: SetNull)

  @@unique([teacherMembershipRef, idempotencyKey])
  /// The student's own history, and one exercise's thread inside it.
  @@index([studentMembershipRef, createdAt(sort: Desc)])
  @@index([studentMembershipRef, materialId, createdAt(sort: Desc)], map: "teacher_feedback_student_material_created_at_idx")
  /// The one note this teacher already wrote this student for this exercise.
  @@index([teacherMembershipRef, studentMembershipRef, materialId, createdAt(sort: Desc)], map: "teacher_feedback_author_thread_idx")
  @@map("teacher_feedback")
}

model ExerciseHint {
  id                 String   @id @default(uuid()) @db.Uuid
  exerciseMaterialId String   @map("exercise_material_id") @db.Uuid
  position           Int
  content            String
  triggerExpression  String?  @map("trigger_expression")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  exercise ProgrammingExercise @relation(fields: [exerciseMaterialId], references: [materialId], onDelete: Cascade)

  @@unique([exerciseMaterialId, position])
  @@map("exercise_hints")
}

/// One student's counted active learning time, in one course, on one
/// academy-local day.
///
/// A projection, not an event log. The alternative — keeping every heartbeat —
/// would store a child's minute-by-minute movements to answer a question that
/// only ever needs a daily total, and the overview has no use for the detail
/// that would make it worth the risk.
///
/// Course rather than class, because the learning route knows the academy and
/// the course and not which class motivated the work. A class counts a row only
/// when the student is enrolled and the course is currently assigned to it, so
/// removing either stops the time from being attributed without deleting it.
///
/// Increments are idempotent through `LearningActivityFlush`: a retried flush
/// finds its receipt already present and adds nothing.
model StudentCourseLearningDay {
  academyId       String   @map("academy_id") @db.Uuid
  membershipId    String   @map("membership_id") @db.Uuid
  courseId        String   @map("course_id") @db.Uuid
  /// The academy-local calendar day, not a UTC one. An evening class must not
  /// be split across two dates.
  localDate       DateTime @map("local_date") @db.Date
  activeSeconds   Int      @default(0) @map("active_seconds")
  /// How many separate intervals those seconds came from, so a total can be
  /// read as one long session or twelve short ones.
  activeIntervals Int      @default(0) @map("active_intervals")
  firstActiveAt   DateTime @map("first_active_at") @db.Timestamptz(6)
  lastActiveAt    DateTime @map("last_active_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  academy    Academy           @relation(fields: [academyId], references: [id], onDelete: Cascade)
  membership AcademyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  course     Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([academyId, membershipId, courseId, localDate])
  /// The academy-wide daily momentum series.
  @@index([academyId, localDate])
  /// One student's own time in one course, for the participation scatter.
  @@index([membershipId, courseId, localDate])
  @@map("student_course_learning_days")
}

/// A receipt for one accepted activity flush.
///
/// The row is the idempotency key. A queued flush carries a UUID generated
/// before the write; the transaction inserts the receipt and increments the
/// daily projection together, so a retry after a timeout collides on the
/// primary key and adds nothing rather than adding the minute twice.
///
/// Receipts are deleted after a week — longer than the queue's retry horizon,
/// short enough that the table stays small.
model LearningActivityFlush {
  id           String   @id @db.Uuid
  academyId    String   @map("academy_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("learning_activity_flushes")
}
