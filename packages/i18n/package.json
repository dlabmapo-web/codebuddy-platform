{
  "name": "@cove/i18n",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./settings": {
      "types": "./dist/settings.d.ts",
      "default": "./dist/settings.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "default": "./dist/format.js"
    },
    "./locales/*": "./src/locales/*"
  },
  "files": [
    "dist",
    "src/locales"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cove/shared": "workspace:^",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
