{
  "name": "@cove/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm db:generate",
    "dev": "nest start --watch",
    "prebuild": "pnpm db:generate",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "pretypecheck": "pnpm db:generate",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @cove/shared build && pnpm db:generate",
    "test": "vitest run",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed/seed.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed:e2e": "tsx prisma/seed/e2e-content.ts",
    "start:judge": "node dist/src/judge/judge.main.js",
    "dev:judge": "tsx watch src/judge/judge.main.ts",
    "db:seed:sandbox": "tsx prisma/seed/manual-sandbox.ts",
    "db:demo": "tsx prisma/seed/demo/demo.ts",
    "db:demo:reset": "tsx prisma/seed/demo/reset.ts",
    "platform:bootstrap-admin": "tsx src/platform/bootstrap-admin.ts"
  },
  "dependencies": {
    "@cove/shared": "workspace:*",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/websockets": "^11.1.28",
    "@orpc/server": "^1.14.4",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@socket.io/redis-streams-adapter": "^0.3.1",
    "@supabase/supabase-js": "^2.108.2",
    "bullmq": "^5.81.3",
    "dotenv": "^17.4.2",
    "fflate": "^0.8.3",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "pyodide": "0.27.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "svix": "^1.99.1",
    "yjs": "^13.6.32",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.20.0",
    "prisma": "^7.9.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
