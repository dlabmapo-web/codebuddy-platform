# Cove Studio v2 API only. Copy this file to .env and replace every placeholder.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=replace_with_supabase_secret_key

# Must match the web application's value. Required in production; use 32+ random bytes.
BFF_SHARED_SECRET=replace_with_at_least_32_random_bytes

# Runtime connection. Use the Supavisor session pooler (port 5432) for local NestJS.
DATABASE_URL=postgresql://replace_with_runtime_connection

# Prisma CLI connection. Prefer the direct connection (port 5432) when IPv6 is available.
DIRECT_URL=postgresql://replace_with_migration_connection
