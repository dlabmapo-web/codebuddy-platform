FROM docker:28-cli AS docker-cli
FROM node:22-bookworm-slim AS dependencies
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/gui-runtime/package.json packages/gui-runtime/package.json
RUN pnpm install --frozen-lockfile --filter @cove/gui-runtime
COPY packages/gui-runtime packages/gui-runtime
RUN pnpm --filter @cove/gui-runtime deploy --prod /service
FROM node:22-bookworm-slim AS runtime
RUN apt-get update && apt-get upgrade -y --no-install-recommends \
 && rm -rf /var/lib/apt/lists/*
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
WORKDIR /service
COPY --from=dependencies /service ./
ENV NODE_ENV=production GUI_BIND_ADDRESS=0.0.0.0
CMD ["node","src/server.mjs"]
